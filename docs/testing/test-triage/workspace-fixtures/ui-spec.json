{
  "sections": [
    {
      "id": "login",
      "name": "로그인 / 회원가입",
      "route": "/login",
      "components": [
        {
          "name": "LoginForm",
          "type": "form",
          "fields": ["email", "password"],
          "actions": ["login", "navigate-to-register"]
        },
        {
          "name": "RegisterForm",
          "type": "form",
          "fields": ["email", "password", "passwordConfirm"],
          "actions": ["register", "navigate-to-login"]
        }
      ],
      "states": ["idle", "loading", "error", "success"]
    },
    {
      "id": "dashboard",
      "name": "대시보드",
      "route": "/dashboard",
      "components": [
        {
          "name": "ProjectList",
          "type": "list",
          "itemProps": ["name", "memberCount", "taskStats", "role"],
          "actions": ["navigate-to-project", "create-project"]
        },
        {
          "name": "ProgressChart",
          "type": "chart",
          "chartType": "bar",
          "dataKeys": ["todo", "inProgress", "done"]
        },
        {
          "name": "MemberWorkload",
          "type": "chart",
          "chartType": "horizontalBar",
          "dataKeys": ["assigned", "completed"]
        }
      ],
      "states": ["loading", "empty", "loaded"]
    },
    {
      "id": "kanban",
      "name": "칸반 보드",
      "route": "/projects/:id",
      "components": [
        {
          "name": "KanbanBoard",
          "type": "container",
          "children": ["KanbanColumn"],
          "interaction": "drag-and-drop"
        },
        {
          "name": "KanbanColumn",
          "type": "container",
          "variants": ["todo", "in_progress", "done"],
          "children": ["TaskCard"],
          "actions": ["drop-task"]
        },
        {
          "name": "TaskCard",
          "type": "card",
          "props": ["title", "priority", "assignee", "dueDate"],
          "actions": ["drag", "open-detail", "change-status"]
        },
        {
          "name": "TaskCreateModal",
          "type": "modal",
          "fields": ["title", "description", "priority", "assigneeId", "dueDate"],
          "actions": ["create", "cancel"]
        }
      ],
      "states": ["loading", "empty", "loaded", "dragging"]
    },
    {
      "id": "task-detail",
      "name": "태스크 상세",
      "route": "/projects/:id (modal overlay)",
      "components": [
        {
          "name": "TaskDetailModal",
          "type": "modal",
          "sections": ["header", "body", "actions"],
          "props": ["title", "description", "status", "priority", "assignee", "dueDate", "createdBy", "createdAt"]
        },
        {
          "name": "TaskActions",
          "type": "actionBar",
          "actions": ["edit", "assign", "change-status", "delete"]
        }
      ]
    },
    {
      "id": "notifications",
      "name": "알림",
      "route": "/notifications",
      "components": [
        {
          "name": "NotificationBell",
          "type": "button",
          "props": ["unreadCount"],
          "placement": "header"
        },
        {
          "name": "NotificationList",
          "type": "list",
          "itemProps": ["type", "message", "isRead", "createdAt"],
          "actions": ["mark-read", "mark-all-read", "navigate-to-source"]
        }
      ],
      "states": ["loading", "empty", "loaded"]
    },
    {
      "id": "project-settings",
      "name": "프로젝트 설정",
      "route": "/projects/:id/settings",
      "components": [
        {
          "name": "ProjectInfoForm",
          "type": "form",
          "fields": ["name", "description"],
          "actions": ["save"]
        },
        {
          "name": "MemberList",
          "type": "list",
          "itemProps": ["email", "role", "joinedAt"],
          "actions": ["invite", "remove-member"]
        }
      ]
    }
  ],
  "layout": {
    "shell": {
      "header": {
        "left": ["Logo"],
        "center": [],
        "right": ["NotificationBell", "UserMenu"]
      },
      "sidebar": {
        "items": ["Dashboard", "ProjectList"],
        "collapsible": true
      },
      "main": {
        "maxWidth": "1280px",
        "padding": "spacing.6"
      }
    }
  }
}
