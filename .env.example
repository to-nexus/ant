# Root .env — read by `docker compose up` for variable interpolation only.
# (The native `pnpm dev:*` flow reads packages/ant-cli/.env instead.)
#
#   cp .env.example .env
#
# One value is enough to start building:
ANTHROPIC_API_KEY=

# Optional extra providers:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# GLM_API_KEY=
# KIMI_API_KEY=

# Optional: pin the credential-store encryption key (64 hex chars,
# `openssl rand -hex 32`). Empty = auto-generated onto the workspace volume.
# ANT_ENCRYPTION_KEY=
