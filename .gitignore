# Dependencies
node_modules/
.pnpm-store/

# pnpm workspace — npm lock 잔재 방지 (pnpm-lock.yaml 만 SSOT)
package-lock.json

# Environment variables
.env
.env.local
.env.*.local
!.env.example.local
.env.backup

# Build outputs
dist/
build/
*.js.map
packages/*/dist/
packages/*/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.openvscode-server/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated files (optional - uncomment if you don't want to track these)
# projects/**/generated/
# projects/**/directives/

# Temporary files
*.tmp
*.temp
.cache/
.buffers/

# ChromaDB data
.chroma/
chroma_data/
vector-memory/chroma-data/

# Vector memory binaries
/packages/ant-cli/src/periphery/integrations/vector-memory/chroma-data/
# New structure (workspaces/)
# Ignore all workspace content by default…
workspaces/**/*
# …but let git descend into every directory so the !-unignores below
# can re-include nested paths (gitignore won't list children of an
# ignored directory).
!workspaces/**/
!workspaces/.gitkeep

# Keep evaluation reports (permanent artifacts).
# gitignore 는 부모가 무시되면 자식의 unignore 가 동작하지 않으므로
# 부모 `meta/` 도 함께 unignore 한 뒤 evals 만 유지한다.
!workspaces/**/meta/
!workspaces/**/meta/evals/**

# Ignore session data (temporary/debug)
workspaces/**/sessions/

# logs
.ant-debug/

# Claude Code (personal data)
.claude/projects/
.claude/plans/
.claude/settings.local.json

# Untracked docs
docs/untracked/
docs/tmp/

# Personal AI agent rules (kept locally, not exposed publicly).
# Public-facing version is AGENTS.md. See docs/internals/ssot-policies.md
# for the contributor-friendly summary.
CLAUDE.md
.cursorrules

# Verification scenario harness runtime (fixture source is in packages/ant-cli/tests/verification-scenarios)
/.ant-test/
.claude/settings.json
