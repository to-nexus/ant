# Dependencies
node_modules/
.pnpm-store/

# pnpm workspace — npm lock 잔재 방지 (pnpm-lock.yaml 만 SSOT)
package-lock.json

# Environment variables
.env
.env.local
.env.*.local
!.env.example.local
.env.backup
.env.bak
*.bak
# Ad-hoc env copies (e.g. "env (1)" from editor/download dupes)
env (*)

# Build outputs
dist/
build/
*.js.map
packages/*/dist/
packages/*/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.openvscode-server/

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Generated files (optional - uncomment if you don't want to track these)
# projects/**/generated/
# projects/**/directives/

# Temporary files
*.tmp
*.temp
.cache/
.buffers/

# ChromaDB data
.chroma/
chroma_data/
vector-memory/chroma-data/

# Vector memory binaries
/packages/ant-cli/src/periphery/integrations/vector-memory/chroma-data/
# New structure (workspaces/)
# Ignore all workspace content by default…
workspaces/**/*
# …but let git descend into every directory so the !-unignores below
# can re-include nested paths (gitignore won't list children of an
# ignored directory).
!workspaces/**/
!workspaces/.gitkeep

# Keep evaluation reports (permanent artifacts).
# gitignore 는 부모가 무시되면 자식의 unignore 가 동작하지 않으므로
# 부모 `meta/` 도 함께 unignore 한 뒤 evals 만 유지한다.
!workspaces/**/meta/
!workspaces/**/meta/evals/**

# Ignore session data (temporary/debug)
workspaces/**/sessions/

# logs
.ant-debug/

# Claude Code (personal / local harness state — not shipped publicly)
.claude/

# Untracked docs
docs/untracked/
docs/tmp/

# Personal AI agent rules (kept locally, not exposed publicly).
# The public-facing source of truth for contributors is AGENTS.md.
CLAUDE.md
.cursorrules

# Verification scenario harness runtime (fixture source is in packages/ant-cli/tests/verification/scenarios)
/.ant-test/

# Test-generated matrices. Written on every `pnpm test:cli` run by
# tests/prompt/template-reverse-matrix.test.ts and
# tests/artifacts/artifact-injection-e2e.test.ts, and read back only by those
# same tests to self-verify the write — never a golden baseline. Tracking them
# meant every local run produced a spurious diff with no CI step to regenerate
# or compare them.
/packages/ant-cli/tests/__generated__/

# Editor / IDE multi-root workspace files (personal layout, not shipped)
*.code-workspace
