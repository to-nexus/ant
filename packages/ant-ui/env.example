# ===========================================
# ANT UI Environment Configuration
# ===========================================

# Cloud Backend URL (without /api suffix)
# VITE_CLOUD_BACKEND_BASE=https://ant-server.crosstoken.io

# Preview Server URL (별도 호스트)
# Production: https://ant-preview.crosstoken.io
# Development: http://localhost:4102
VITE_PREVIEW_HOST=http://localhost:4102

# OAuth 스킵 (로컬 모드용)
# true: OAuth 없이 이메일로 로그인, false: OAuth 필수
VITE_SKIP_AUTH_FOR_LOCALHOST=true
