# ===========================================
# ANT UI Environment Configuration
# ===========================================
#
# Both URLs default to same-origin (empty). Set them only when the API
# / preview server live on a separate host from the FE bundle.

# Cloud Backend URL (without /api suffix).
# Example: VITE_CLOUD_BACKEND_BASE=https://api.your-domain.tld
VITE_CLOUD_BACKEND_BASE=

# Preview Server URL.
# Example: VITE_PREVIEW_HOST=https://preview.your-domain.tld
VITE_PREVIEW_HOST=
