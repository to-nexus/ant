# ===========================================
# ANT UI Environment Configuration
# ===========================================
#
# 백엔드 모드와 로컬 포트는 UI에서 사용자가 설정합니다 (localStorage).
# 환경변수는 클라우드 백엔드 URL만 설정하면 됩니다.

# ┌─────────────────────────────────────────┐
# │          CLOUD BACKEND URL              │
# └─────────────────────────────────────────┘

# 클라우드 백엔드 URL (without /api suffix)
# - ANT Works 클라우드 서비스 사용 시 필요
VITE_CLOUD_BACKEND_BASE=https://api.ant.works

# 경로 라우팅 (Ingress):
#   /api/*      → ant-api
#   /realtime/* → ant-realtime  
#   /preview/*  → ant-preview
#   /ide/*      → ant-api (IDE proxy)

# ┌─────────────────────────────────────────┐
# │               AUTH                      │
# └─────────────────────────────────────────┘

# OAuth 스킵 (로컬 모드용)
# - true: OAuth 없이 이메일로 로그인 (로컬 백엔드)
# - false: OAuth 필수 (클라우드 백엔드)
VITE_SKIP_AUTH_FOR_LOCALHOST=true

# ┌─────────────────────────────────────────┐
# │         USER SETTINGS (localStorage)    │
# └─────────────────────────────────────────┘
#
# 다음 설정들은 UI에서 사용자가 변경합니다:
#
# - backendMode: 'local' | 'cloud'
#   → 로컬 백엔드(온프레미스) 또는 클라우드 백엔드 선택
#
# - localBackendPort: number (default: 4100)
#   → 로컬 백엔드 포트 (local 모드일 때 http://localhost:{port} 사용)
