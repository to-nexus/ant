# ===========================================
# ANT UI Environment Configuration
# ===========================================
# Copy this file to .env.development.local and modify values

# Backend URLs
# - Local: Your local ant-cli server (for Local mode)
# - Cloud: Cloud ant-cli server (for Cloud mode)
VITE_LOCAL_BACKEND_BASE=http://localhost:4000/api
VITE_CLOUD_BACKEND_BASE=http://localhost:4100/api

# OAuth Configuration (for Cloud mode sign-in)
# Set to 'true' to skip Google OAuth and use email-only auth
# Recommended for local development/testing
VITE_SKIP_AUTH_FOR_LOCALHOST=true
