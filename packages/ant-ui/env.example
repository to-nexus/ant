# ===========================================
# ANT UI Environment Configuration
# ===========================================
# 
# VITE_BACKEND_BASE: 백엔드 서버 주소
# - 미설정시 상대경로 사용 (로컬 개발 - Vite 프록시가 라우팅)
# - 클라우드 배포시 반드시 설정 필요
#
# 경로 라우팅 (Ingress):
#   /api/*      → ant-api
#   /realtime/* → ant-realtime  
#   /preview/*  → ant-preview
#   /ide/*      → ant-api (IDE proxy)

# ┌─────────────────────────────────────────┐
# │            BACKEND SERVER               │
# └─────────────────────────────────────────┘

# 백엔드 서버 주소 (Ingress endpoint)
# - 로컬 개발: 미설정 (Vite 프록시 사용)
# - 클라우드: https://ant-server.crosstoken.io
# VITE_BACKEND_BASE=https://ant-server.crosstoken.io

# ┌─────────────────────────────────────────┐
# │               AUTH                      │
# └─────────────────────────────────────────┘

# OAuth 스킵 (로컬 개발용)
VITE_SKIP_AUTH_FOR_LOCALHOST=true
