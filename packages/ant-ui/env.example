# ===========================================
# ANT UI Environment Configuration
# ===========================================
# 
# 대부분의 경우 환경변수 설정 불필요!
#
# 모든 API 호출은 상대경로 사용:
#   /api/*      → ant-api
#   /realtime/* → ant-realtime  
#   /preview/*  → ant-preview
#   /ide/*      → ant-api (IDE proxy)
#
# 라우팅은 환경에 따라 자동 처리:
#   - 로컬 개발: Vite 프록시 (vite.config.ts)
#   - 클라우드:  Ingress/ALB

# ┌─────────────────────────────────────────┐
# │               AUTH                      │
# └─────────────────────────────────────────┘

# OAuth 스킵 (로컬 개발용)
VITE_SKIP_AUTH_FOR_LOCALHOST=true
