# ===========================================
# ANT UI - Development Build
# ===========================================
#
# Defaults assume the Vite dev server (port 4200) proxies /api/* and
# /realtime/* to ant-cli (port 4100). Override per developer in
# `.env.development.local` (gitignored) when pointing at a remote
# backend.

# Cloud FE overlay (billing + cloud-auth slices/slots) gate. Unset/empty in the
# public OSS repo → the `@ant/cloud/ui` graph is dead-code-eliminated by Vite
# (see docs/tmp/oss-cloud-split-handoff.md §4.2). The private ant-cloud build
# injects VITE_INCLUDE_CLOUD=true (env override) to include the overlay.
VITE_INCLUDE_CLOUD=

# Cloud Backend URL — empty = same-origin (Vite proxy handles routing).
VITE_CLOUD_BACKEND_BASE=

# Preview Server URL — empty = same-origin. Set explicitly when running
# ant-preview on a non-default host.
VITE_PREVIEW_HOST=
