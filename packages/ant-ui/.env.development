# ===========================================
# ANT UI - Development Build
# ===========================================
#
# 개발 빌드용 설정
# 백엔드 모드는 사용자가 UI에서 선택합니다.
# 로컬 모드 시 Vite proxy가 라우팅합니다.

# Cloud Backend URL (without /api suffix)
# VITE_CLOUD_BACKEND_BASE=https://ant-server.crosstoken.io

# Preview Server URL
VITE_PREVIEW_HOST=http://localhost:4102

# Auth - 클라우드에서는 OAuth 필수
VITE_SKIP_AUTH_FOR_LOCALHOST=false
