VITE_FRONTEND_MODE=cloud
VITE_LOCAL_BACKEND_BASE=http://localhost:4000/api
VITE_CLOUD_BACKEND_BASE=http://localhost:4100/api

# Skip authentication for localhost (development convenience)
# Set to 'true' to bypass Google OAuth when accessing from localhost
VITE_CLOUD_BACKEND_BASE=https://ant-server.crosstoken.io/api
VITE_FRONTEND_MODE=cloud
VITE_SKIP_AUTH_FOR_LOCALHOST=false
VITE_TARGET_BACKEND_MODE=cloud
