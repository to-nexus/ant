# ===========================================
# ANT UI - Cloud Mode (Production Build)
# ===========================================
#
# Single-origin deployments (FE + API on the same host) leave both URLs
# empty so every fetch uses a relative path and the browser auto-prefixes
# the current origin. Sub-domain split deployments override per env.

# Cloud Backend URL (without /api suffix). Empty = same-origin (recommended).
VITE_CLOUD_BACKEND_BASE=

# Preview Server URL. Empty = same-origin. Set when preview lives on a
# separate host (e.g. https://preview.your-domain.tld).
VITE_PREVIEW_HOST=
