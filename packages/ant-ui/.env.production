# ===========================================
# ANT UI - Cloud Mode (Production Build)
# ===========================================
#
# Split-host production deployment: FE and API live on different hosts,
# so absolute URLs are baked into the dist at build time. Leave empty
# only when transitioning to a single-origin (reverse-proxied) layout.

# Cloud FE overlay (billing + cloud-auth slices/slots) gate. Unset/empty in the
# public OSS repo → the `@ant/cloud/ui` graph is dead-code-eliminated by Vite.
# SSOT for the FE half of the OSS/cloud seam (see docs/tmp/oss-cloud-split-handoff.md §4.2).
# The private ant-cloud UI build injects VITE_INCLUDE_CLOUD=true (env override).
VITE_INCLUDE_CLOUD=

# Cloud Backend URL (without /api suffix). Production split-host SSOT.
VITE_CLOUD_BACKEND_BASE=https://ant-server.cross.nexus

# Preview Server URL. Production preview host SSOT.
VITE_PREVIEW_HOST=https://ant-preview.cross.nexus

# Preview/deploy CONTENT URL — where the user's own app is served.
#
# A separate origin from VITE_PREVIEW_HOST on purpose: the content origin serves
# attacker-authorable documents (a public deploy's build output, a user's dev
# server), so it must not be the origin the `/projects/*` control plane answers on
# (report H-NEW-001). Empty = fall back to VITE_PREVIEW_HOST, which keeps a
# not-yet-migrated single-host deployment working unchanged.
# Set once the deployment publishes the content listener on its own host.
VITE_PREVIEW_CONTENT_HOST=

# Marketing site (ant-site) URL — post-logout destination. Unset → ant-ui
# logs out into its own welcome screen ("/"). Set → unified logout
# procedure hard-navigates here so the user lands on the marketing
# surface after signing out. ant-ui must boot fine WITHOUT this set
# (no hard dependency on ant-site).
VITE_ANT_SITE_URL=https://ant.cross.nexus/
