# ===========================================
# ANT UI - Cloud Mode (Production Build)
# ===========================================
#
# 클라우드 배포용 설정
# 백엔드 모드는 사용자가 UI에서 선택합니다.

# Cloud Backend URL (without /api suffix)
VITE_CLOUD_BACKEND_BASE=https://ant-server.example.com

# Preview Server URL (별도 호스트)
VITE_PREVIEW_HOST=https://ant-preview.example.com

# Auth - 클라우드에서는 OAuth 필수
VITE_SKIP_AUTH_FOR_LOCALHOST=false
