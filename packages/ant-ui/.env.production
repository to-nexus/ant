# ===========================================
# ANT UI - Production
# ===========================================
# 
# VITE_BACKEND_BASE: 백엔드 서버 주소 (Ingress 진입점)
# - api, realtime, preview, ide 모두 이 주소의 Ingress 경로로 라우팅됨
# - 미설정시 상대경로 사용 (CloudFront 등에서 프록시 필요)
#
# 경로 라우팅 (Ingress):
#   /api/*      → ant-api
#   /realtime/* → ant-realtime
#   /preview/*  → ant-preview
#   /ide/*      → ant-api (IDE proxy)

# Backend Server (Ingress endpoint)
VITE_BACKEND_BASE=https://ant-server.crosstoken.io

# Auth
VITE_SKIP_AUTH_FOR_LOCALHOST=false
