# ===========================================
# ANT UI - Cloud Mode (Production Build)
# ===========================================
#
# Split-host production deployment: FE and API live on different hosts,
# so absolute URLs are baked into the dist at build time. Leave empty
# only when transitioning to a single-origin (reverse-proxied) layout.

# Cloud Backend URL (without /api suffix). Production split-host SSOT.
VITE_CLOUD_BACKEND_BASE=https://ant-server.crosstoken.io

# Preview Server URL. Production preview host SSOT.
VITE_PREVIEW_HOST=https://ant-preview.crosstoken.io
