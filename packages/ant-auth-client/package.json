{
  "name": "@ant/auth-client",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/to-nexus/ant.git",
    "directory": "packages/ant-auth-client"
  },
  "bugs": "https://github.com/to-nexus/ant/issues",
  "homepage": "https://github.com/to-nexus/ant#readme",
  "description": "Unified browser auth client for ant-site and ant-ui (fetch /auth/me, signout, broadcaster, OAuth URLs, logout/mount procedures). Source-resolvable: consumers (Vite, Vitest, Next.js transpilePackages) read TS source directly — no separate build step.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
