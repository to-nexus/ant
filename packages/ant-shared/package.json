{
  "name": "@ant/shared",
  "version": "1.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Shared types between ant-cli (backend) and ant-ui (frontend)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/to-nexus/ant.git",
    "directory": "packages/ant-shared"
  },
  "bugs": "https://github.com/to-nexus/ant/issues",
  "homepage": "https://github.com/to-nexus/ant#readme",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
