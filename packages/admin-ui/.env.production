# ===========================================
# ANT ADMIN UI - Cloud Mode (Production Build)
# ===========================================
#
# Vite SPA: the API host is baked into the bundle at build time. CI injects
# shell VITE_* from the GitHub Environment vars, which override this file.
#
# Not relative on purpose — admin-ui used to call `/api` on the CDN host, which
# made it the only surface depending on a CloudFront `/api/*` behavior that no
# IaC owns. Same value as ant-ui's `.env.production`.

# Cloud Backend URL (without /api suffix). Production split-host SSOT.
VITE_CLOUD_BACKEND_BASE=https://ant-server.cross.nexus
