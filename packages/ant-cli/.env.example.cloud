# ===========================================
# Ant CLI - CLOUD MODE (Kubernetes)
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=cloud
ANT_REDIS_URL=rediss://axant-dev-single.ax-dev.pri.cross-nexus.com:6379
ANT_WORKSPACE_BASE_PATH=/mnt/workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# JWT Authentication (required for cloud mode, used by ant-api, ant-realtime, ant-preview)
# Generate: openssl rand -base64 48
ANT_JWT_SECRET=your-jwt-secret-at-least-32-characters

# Cookie Domain (optional). Leave unset for single-origin deployments —
# the auth cookie is then host-only and naturally scoped to the response
# host. Set explicitly (with leading dot) only when FE and API live on
# different sub-domains and a single cookie must span both.
# COOKIE_DOMAIN=.your-domain.tld

# Additional CORS origins (comma-separated). Same-origin requests do not
# need this. List every cross-origin host the FE / preview / staging may
# call from, e.g. https://staging.your-domain.tld
ANT_CORS_ORIGINS=https://ant.crosstoken.io

# ┌─────────────────────────────────────────┐
# │                LLM API                  │
# └─────────────────────────────────────────┘

AI_MODEL_NAME=claude-sonnet-4-6
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# Google OAuth — replace placeholder hosts with the deployment domain
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.tld/api/auth/google/callback
FRONTEND_URL=https://your-domain.tld

# IDE Orchestration (Kubernetes)
ANT_K8S_NAMESPACE=ant-ide
ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=proxy

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용 (deployment-internal URL of ant-api)
ANT_API_URL=https://your-domain.tld

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
RECURSION_LIMIT=100
GIT_DEFAULT_BASE=main
ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory (opt-in)
# Set to `true` to enable codebase indexing + vector-backed RAG.
# Default is OFF — when disabled, the learn job + indexing pipeline are
# short-circuited and RAG falls back to git-changes + keyword search.
ANT_VECTOR_DB_ENABLED=false
CHROMA_URL=http://10.0.28.172:8000
EMBEDDER_URL=http://10.0.28.172:8001

# Visual Processor (background removal sidecar)
ANT_VISUAL_PROCESSOR_URL=http://10.0.28.172:4103