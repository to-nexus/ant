# =============================================
# Ant CLI - CLOUD MODE Configuration
# =============================================
# Distributed deployment: ant-api, ant-job, ant-preview
# Usage: cp .env.example.cloud .env
#
# Each server needs COMMON + its own section:
#   ant-api    : COMMON + ant-api
#   ant-job    : COMMON + ant-job
#   ant-preview: COMMON + ant-preview
# =============================================

# ======================
# COMMON (All servers)
# ======================

ANT_SERVER_MODE=cloud
ANT_REDIS_URL=redis://your-elasticache.xxx.cache.amazonaws.com:6379

# LLM API (ant-api, ant-job)
# Provider auto-detected from model name (claude-* → anthropic, gpt-* → openai)
AI_MODEL_NAME=claude-sonnet-4-5-20250929
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage (ant-api, ant-preview)
ANT_WORKSPACE_BASE_PATH=/mnt/workspaces

# Git (ant-api, ant-job)
GIT_DEFAULT_BASE=main

# Job execution limit (ant-api, ant-job)
RECURSION_LIMIT=800

# Allow all commands for tooling (ant-job)
ANT_UNSAFE_ALLOW_ALL_COMMANDS=1

# ======================
# ant-api
# ======================

ANT_CLI_PORT=4100
ANT_PREVIEW_WORKERS=http://ant-preview

# Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ant.crosstoken.io/api/auth/google/callback
FRONTEND_URL=https://ant.crosstoken.io
SKIP_AUTH_FOR_LOCALHOST=false
# Encryption key for credentials (GitHub PAT, etc.) - Generate with: openssl rand -hex 32
ANT_ENCRYPTION_KEY=

# Cloud IDE
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=user
# ANT_IDE_HOME_BASE_PATH=/mnt/ide-homes
# ANT_K8S_NAMESPACE=ant-ide

# Vector Memory (Optional)
CHROMA_URL=http://chromadb
EMBEDDER_URL=http://embedder

# Figma Integration (Optional)
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# FIGMA_REDIRECT_URI=

# Debug
DEBUG_KANBAN=0

# ======================
# ant-job
# ======================

ANT_WORKER_CONCURRENCY=2
# ANT_JOB_QUEUE_NAME=ant-jobs

# ======================
# ant-preview
# ======================

ANT_PREVIEW_WORKER_PORT=8080
