# ===========================================
# Ant CLI - CLOUD MODE (Kubernetes)
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON + PREVIEW SERVER sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=cloud
ANT_REDIS_URL=rediss://axant-dev-single.ax-dev.pri.cross-nexus.com:6379
ANT_WORKSPACE_BASE_PATH=/mnt/workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# JWT Authentication (required for cloud mode, used by ant-api, ant-realtime, ant-preview)
# Generate: openssl rand -base64 48
ANT_JWT_SECRET=your-jwt-secret-at-least-32-characters

# Cookie Domain (optional). Leave unset for single-origin deployments —
# the auth cookie is then host-only and naturally scoped to the response
# host. Set explicitly (with leading dot) only when FE and API live on
# different sub-domains and a single cookie must span both.
# COOKIE_DOMAIN=.your-domain.tld

# Additional CORS origins (comma-separated). Same-origin requests do not
# need this. List every cross-origin host the FE / preview / staging may
# call from, e.g. https://staging.your-domain.tld
ANT_CORS_ORIGINS=https://ant.cross.nexus

# ┌─────────────────────────────────────────┐
# │                LLM API                  │
# └─────────────────────────────────────────┘

AI_MODEL_NAME=claude-sonnet-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
# DeepSeek — OpenAI-compatible API (models via api.deepseek.com). Third-party
# China-hosted provider; see the in-app consent notice before enabling.
DEEPSEEK_API_KEY=your-deepseek-api-key

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# Google OAuth — replace placeholder hosts with the deployment domain
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.tld/api/auth/google/callback
FRONTEND_URL=https://your-domain.tld

# IDE Orchestration (Kubernetes)
ANT_K8S_NAMESPACE=ant-ide
ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=proxy

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용 (deployment-internal URL of ant-api)
ANT_API_URL=https://your-domain.tld

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
RECURSION_LIMIT=100
GIT_DEFAULT_BASE=main
ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# ┌─────────────────────────────────────────┐
# │        PREVIEW SERVER (ant-preview)     │
# └─────────────────────────────────────────┘

# Per-app subdomain routing (opt-in). By DEFAULT preview/deploy apps are served
# under a URL path prefix on one host:
#   preview  https://<host>/{urlKey}/...
#   deploy   https://<host>/deploy/{urlKey}/...
# Setting a base domain switches to serving each app at its OWN host ROOT:
#   https://{label}.<baseDomain>/...
# which removes the whole class of "root-absolute asset loses the path prefix"
# bugs (e.g. Next.js images 404 in preview/deploy).
#
# The PRESENCE of ANT_PREVIEW_BASE_DOMAIN is the single switch — unset = path
# routing. Turning it on REQUIRES infra provisioned separately:
#   - wildcard DNS   *.ant-preview.cross.nexus  AND  *.ant-deploy.cross.nexus
#   - wildcard TLS certs for both
#   - the ingress/ALB forwarding the original Host header to ant-preview
# Setting the preview base ALSO switches deploy to subdomain routing, so both
# base domains + both wildcards must be ready together. ⚠️ If these are set
# WITHOUT the wildcard DNS/TLS provisioned, preview/deploy URLs will not resolve
# — comment them out to fall back to path routing until the infra is ready.
ANT_PREVIEW_BASE_DOMAIN=ant-preview.cross.nexus
ANT_DEPLOY_BASE_DOMAIN=ant-deploy.cross.nexus

# Per-request preview-proxy tracing (debug, opt-in). When set to any non-empty
# value, the subdomain preview path emits a `warn`-level trace per request
# (host / x-forwarded-host / label / match / cross-pod owner-forward decision /
# target) so a 504 or mis-route in a multi-replica deployment is diagnosable from
# the pod logs. OFF by default (unset). Turn on only while investigating; it is
# one line per request. The boot "routing diag" line (mode / base domains / podId
# / POD_IP / PORT / build marker) always logs regardless of this flag.
# ANT_PREVIEW_TRACE=1

# Custom domains (deploy-only, opt-in). Lets a user attach a domain they OWN to
# a deploy (e.g. app.mycompany.com), served in-place over auto-issued HTTPS.
# The PRESENCE of ANT_CUSTOM_DOMAIN_CNAME_TARGET is the single switch — unset =
# custom domains disabled (the register endpoint returns 503).
#
# ⚠️ Turning it on REQUIRES the NLB + Caddy on-demand-TLS layer provisioned
# separately (see docs/infra/custom-domains.md). Do NOT set these until that
# layer exists — otherwise the UI hands users a CNAME target that resolves to
# nothing. This layer is distinct from the subdomain wildcard above (which our
# ALB + ACM already serve); custom user domains need on-demand cert issuance.
#   - ANT_CUSTOM_DOMAIN_CNAME_TARGET (required to enable): stable hostname users
#     CNAME a SUBDOMAIN to, resolving to the NLB in front of Caddy.
#   - ANT_CUSTOM_DOMAIN_APEX_IPS (optional): comma-separated NLB elastic IPs for
#     APEX (root) domain A-records — the SAME fixed EIPs that
#     ANT_CUSTOM_DOMAIN_CNAME_TARGET resolves to. Must be static (EIP), or apex
#     A-records break when the IP rotates. Omit if apex is not supported.
#   - ANT_TLS_ASK_SECRET (optional): shared secret Caddy sends on the
#     /internal/tls-ask probe (X-Ant-Tls-Ask-Secret) — defense-in-depth atop
#     the NetworkPolicy that already restricts the endpoint to Caddy.
#     Generate: openssl rand -hex 32
ANT_CUSTOM_DOMAIN_CNAME_TARGET=ant-domains.cross.nexus
# ANT_CUSTOM_DOMAIN_APEX_IPS=3.34.11.22,13.125.33.44
ANT_TLS_ASK_SECRET=your-tls-ask-secret-openssl-rand-hex-32

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory (opt-in)
# Set to `true` to enable codebase indexing + vector-backed RAG.
# Default is OFF — when disabled, the learn job + indexing pipeline are
# short-circuited and RAG falls back to git-changes + keyword search.
ANT_VECTOR_DB_ENABLED=false
CHROMA_URL=http://10.0.28.172:8000
EMBEDDER_URL=http://10.0.28.172:8001

# Visual Processor (background removal sidecar)
ANT_VISUAL_PROCESSOR_URL=http://10.0.28.172:4103