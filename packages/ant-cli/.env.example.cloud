# ===========================================
# Ant CLI - CLOUD MODE (Kubernetes)
# ===========================================
# Production deployment with OAuth authentication.
# Each service runs in its own Pod with default PORT=8080.
# K8s Service handles routing - no explicit port configuration needed.
#
# ⚠️  실제 값은 Vault / K8s Secret / ConfigMap에서 주입됨
#     이 파일은 필요한 환경변수 목록만 제공
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=cloud
ANT_REDIS_URL=redis://your-redis-host:6379
ANT_WORKSPACE_BASE_PATH=/mnt/workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# ┌─────────────────────────────────────────┐
# │                LLM API                  │
# └─────────────────────────────────────────┘

AI_MODEL_NAME=claude-sonnet-4-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# ┌─────────────────────────────────────────┐
# │           API SERVER (ant-api)          │
# └─────────────────────────────────────────┘

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://ant-server.crosstoken.io/api/auth/google/callback
FRONTEND_URL=https://ant.crosstoken.io
SKIP_AUTH_FOR_LOCALHOST=false

# IDE Orchestration (Kubernetes)
ANT_K8S_NAMESPACE=ant-ide
ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=proxy

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용
ANT_API_URL=https://ant-server.crosstoken.io

ANT_WORKER_CONCURRENCY=3
RECURSION_LIMIT=20
GIT_DEFAULT_BASE=main
ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory
CHROMA_URL=http://your-chromadb-host:8000
EMBEDDER_URL=http://your-embedder-host:8001

# Figma Integration
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret
FIGMA_REDIRECT_URI=https://your-domain.com/api/auth/figma/callback

# ┌─────────────────────────────────────────┐
# │                DEBUG                    │
# └─────────────────────────────────────────┘

DEBUG_KANBAN=false
