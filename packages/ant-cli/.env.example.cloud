# ===========================================
# Ant CLI - CLOUD MODE
# ===========================================
# Production deployment with OAuth authentication.
# Run ant-api, ant-realtime, ant-job, ant-preview as separate services.
#
# Usage per service:
#   ant-api     : COMMON + API SERVER sections
#   ant-realtime: COMMON + REALTIME SERVER sections
#   ant-job     : COMMON + JOB WORKER sections
#   ant-preview : COMMON + PREVIEW WORKER sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

# Server Mode: local (auto-login) | cloud (OAuth)
ANT_SERVER_MODE=cloud

# Redis (Required)
ANT_REDIS_URL=redis://redis.internal:6379

# Workspace Storage (Shared filesystem)
ANT_WORKSPACE_BASE_PATH=/mnt/efs/workspaces

# Encryption Key (generate: openssl rand -hex 32)
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# LLM API
AI_MODEL_NAME=claude-sonnet-4-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# ┌─────────────────────────────────────────┐
# │           API SERVER (ant-api)          │
# └─────────────────────────────────────────┘

ANT_CLI_PORT=4100

# Preview Worker URLs (comma-separated)
ANT_PREVIEW_WORKERS=http://preview-1.internal:8080,http://preview-2.internal:8080

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback
FRONTEND_URL=https://your-frontend-domain.com
SKIP_AUTH_FOR_LOCALHOST=false

# IDE Orchestration
# Not set: Docker | Set: Kubernetes
ANT_K8S_NAMESPACE=ant-ide
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
# ANT_IDE_HOSTNAME_MODE=proxy

# Vector Memory (Optional)
# CHROMA_URL=http://chromadb.internal:8000
# EMBEDDER_URL=http://embedder.internal:8001

# Figma Integration (Optional)
# FIGMA_CLIENT_ID=your-figma-client-id
# FIGMA_CLIENT_SECRET=your-figma-client-secret
# FIGMA_REDIRECT_URI=https://your-domain.com/api/auth/figma/callback

# ┌─────────────────────────────────────────┐
# │      REALTIME SERVER (ant-realtime)     │
# └─────────────────────────────────────────┘

ANT_REALTIME_PORT=4101

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

ANT_WORKER_CONCURRENCY=3
RECURSION_LIMIT=20
GIT_DEFAULT_BASE=main
# ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# ┌─────────────────────────────────────────┐
# │       PREVIEW WORKER (ant-preview)      │
# └─────────────────────────────────────────┘

ANT_PREVIEW_WORKER_PORT=8080

# ┌─────────────────────────────────────────┐
# │             DEBUG (Optional)            │
# └─────────────────────────────────────────┘

# DEBUG_KANBAN=false
