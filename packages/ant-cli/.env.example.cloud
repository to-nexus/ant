# ===========================================
# Ant CLI - CLOUD MODE (Kubernetes)
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + AUTH KEYS (private + public) + LLM API + API SERVER sections
#   ant-realtime: COMMON + AUTH KEYS (public only) sections
#   ant-job     : COMMON + LLM API + JOB WORKER + CHILD ISOLATION sections — NO auth keys (refuses to boot with any)
#   ant-preview : COMMON + AUTH KEYS (public only) + PREVIEW SERVER + CHILD ISOLATION sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=cloud
ANT_REDIS_URL=rediss://your-redis-host:6379

# Skip TLS hostname verification on rediss:// connections. Leave unset (full
# verification) unless you hit a certificate/hostname mismatch — the one known
# case is AWS ElastiCache Serverless behind a custom CNAME, whose certificate is
# issued for *.serverless.*.cache.amazonaws.com rather than your domain.
# Enabling it keeps traffic encrypted but stops detecting a DNS-level MITM.
# Prefer the native ElastiCache endpoint or a PrivateLink VPC endpoint instead.
ANT_REDIS_TLS_SKIP_HOSTNAME_CHECK=false

ANT_WORKSPACE_BASE_PATH=/mnt/workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# Cookie Domain (optional). Leave unset for single-origin deployments —
# the auth cookie is then host-only and naturally scoped to the response
# host. Set explicitly (with leading dot) only when FE and API live on
# different sub-domains and a single cookie must span both.
# COOKIE_DOMAIN=.your-domain.tld

# Additional CORS origins (comma-separated). Same-origin requests do not
# need this. List every cross-origin host the FE / preview / staging may
# call from, e.g. https://staging.your-domain.tld
ANT_CORS_ORIGINS=https://ant.your-domain.tld

# ┌─────────────────────────────────────────┐
# │   AUTH KEYS (scoped PER SERVICE)        │
# └─────────────────────────────────────────┘
#
# ⚠️ Never ship these in a shared env bundle — each process refuses to boot
# with more key material than its role:
#   ant-api                    : ANT_JWT_PRIVATE_KEY + ANT_JWT_PUBLIC_KEY
#   ant-realtime / ant-preview : ANT_JWT_PUBLIC_KEY only
#   ant-job                    : none
#   Generate: openssl ecparam -genkey -name prime256v1 -noout -out jwt.key \
#             && openssl ec -in jwt.key -pubout -out jwt.pub
# Values are PEM file contents.
ANT_JWT_PRIVATE_KEY=
ANT_JWT_PUBLIC_KEY=

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# ── System default models ─────────────────────────────────────────────────
# Which ABSTRACT model each job/node default binds to, as "<provider>:<tier>".
# A tier names one provider's model family above version; the tier → concrete id
# map is code-owned (MODEL_REGISTRY in @ant/shared), because that changes when a
# provider ships a model. What you set here is the binding, so moving the code job
# onto GLM or commit messages onto Haiku needs no rebuild.
#
# Available tiers:
#   anthropic : sonnet opus haiku
#   openai    : sol terra luna
#   google    : pro flash proImage flashImage
#   deepseek  : pro flash
#   glm       : flagship fast
#   kimi      : flagship code codeHighspeed
#
# A per-project override in the UI still wins over these. An unknown / malformed
# value is logged and ignored in favour of the built-in binding. Leave commented to
# use the built-ins shown. Requires the matching provider API key below.
# ANT_DEFAULT_MODEL_DESIGN=anthropic:sonnet
# ANT_DEFAULT_MODEL_DESIGN_DECOMPOSE=anthropic:sonnet
# ANT_DEFAULT_MODEL_DESIGN_PLAN=anthropic:opus
# ANT_DEFAULT_MODEL_DESIGN_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE_DECOMPOSE=anthropic:opus
# ANT_DEFAULT_MODEL_CODE_PLAN=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_LEARN=anthropic:sonnet
# ANT_DEFAULT_MODEL_PLAN=anthropic:sonnet
# ANT_DEFAULT_MODEL_PLAN_PLAN=anthropic:opus
# ANT_DEFAULT_MODEL_PLAN_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_REVIEWER=anthropic:opus
# ANT_DEFAULT_MODEL_DOC=anthropic:opus
# Auxiliary one-shot call: the ant-authored commit message.
# ANT_DEFAULT_MODEL_UNIVERSAL=anthropic:sonnet
# ANT_DEFAULT_MODEL_COMMIT=anthropic:sonnet
# Visual/creator job. sketch + render MUST bind to image-generation tiers
# (google:proImage / google:flashImage) — a text tier there is rejected.
# ANT_DEFAULT_MODEL_VISUAL=google:flash
# ANT_DEFAULT_MODEL_VISUAL_DIRECT=google:pro
# ANT_DEFAULT_MODEL_VISUAL_EXPLAIN=google:pro
# ANT_DEFAULT_MODEL_VISUAL_ENGRAVE=google:pro
# ANT_DEFAULT_MODEL_VISUAL_SKETCH=google:flashImage
# ANT_DEFAULT_MODEL_VISUAL_RENDER=google:proImage
# Used only when a call maps to no slot at all.
# ANT_DEFAULT_MODEL_FALLBACK=anthropic:sonnet
# Fallback only — per-call sampling policy is the SSOT
# (src/core/ports/llmSampling.ts LLM_TEMPERATURE); this value applies
# only to call sites that pass no explicit temperature.
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
# DeepSeek — OpenAI-compatible API (models via api.deepseek.com). Third-party
# China-hosted provider; see the in-app consent notice before enabling.
DEEPSEEK_API_KEY=your-deepseek-api-key
# GLM (Zhipu / Z.ai) — OpenAI-compatible API (models via api.z.ai). Third-party
# China-hosted provider; see the in-app consent notice before enabling.
GLM_API_KEY=your-glm-api-key
# Kimi (Moonshot AI) — OpenAI-compatible API (models via api.moonshot.ai). Third-party
# China-hosted provider; see the in-app consent notice before enabling.
KIMI_API_KEY=your-kimi-api-key

# Per-job sampling overrides. Both are FALLBACKS only — per-call policy is the SSOT
# (src/core/ports/llmSampling.ts). {JOB} is the upper-cased agent job, e.g.
# CODE_MODEL_TEMPERATURE / DESIGN_MODEL_MAX_TOKENS.
# CODE_MODEL_TEMPERATURE=0.7
# CODE_MODEL_MAX_TOKENS=16000

# Operator hard opt-outs for provider reasoning. Only these providers expose one.
# DEEPSEEK_THINKING=disabled
# GLM_THINKING=disabled
# OPENAI_REASONING_EFFORT=low|medium|high|xhigh

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# Google OAuth — replace placeholder hosts with the deployment domain
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.tld/api/auth/google/callback
FRONTEND_URL=https://your-domain.tld

# IDE Orchestration (Kubernetes)
ANT_K8S_NAMESPACE=ant-ide
ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=proxy

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용 (deployment-internal URL of ant-api)
ANT_API_URL=https://your-domain.tld

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
# Calibrated for tool-call file authoring (each write round = 2 graph steps)
RECURSION_LIMIT=300
GIT_DEFAULT_BASE=main
ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# ┌─────────────────────────────────────────┐
# │ CHILD ISOLATION (ant-job & ant-preview) │
# └─────────────────────────────────────────┘

# OS identity for user-authored children (run_command, preview dev servers,
# dependency installs). Cloud mode is FAIL-CLOSED: without these, every
# user-authored spawn is refused. Fixed non-secret integers naming the
# unprivileged account the image (or host) provides (ant-child uid 10001;
# gid = the service's shared group, 1000 in the cloud image) — identical on
# every replica, never per-pod. The spawning process must also be PERMITTED
# to change uids (root, or CAP_SETUID/CAP_SETGID — pod securityContext in
# k8s, `user: 0:0` in compose, root/sudo for a direct-dotenv launch — see
# docs/guides/self-host-cloud.md). Only ant-job and ant-preview consume
# them; in per-service bundles (Vault/compose) scope them to those two, and
# in a single shared .env they are harmless to the other processes.
ANT_CHILD_UID=10001
ANT_CHILD_GID=1000
# Dedicated identity for the ONE child that carries a user's registry/git PAT:
# the credentialed dependency-FETCH pass. /proc/<pid>/environ is mode 0400 owned
# by the process UID, so this child must NOT share ANT_CHILD_UID — otherwise a
# concurrently running dev server or lifecycle script (tenant-authored code)
# running under that shared UID can read the PAT straight out of its environment.
# Cloud is FAIL-CLOSED: a credentialed fetch is refused unless this is set and
# differs from both the service UID and ANT_CHILD_UID. Same `ant` group, so the
# tree it writes stays writable by the credential-free lifecycle pass.
ANT_CHILD_ACQUIRE_UID=10002
ANT_CHILD_ACQUIRE_GID=1000
# Umask keeping the shared workspace group-writable across the identities.
# Already set as an image default — override only if your image differs.
# ANT_CHILD_UMASK=002

# ┌─────────────────────────────────────────┐
# │        PREVIEW SERVER (ant-preview)     │
# └─────────────────────────────────────────┘

# Per-app subdomain routing (opt-in). By DEFAULT preview/deploy apps are served
# under a URL path prefix on one host:
#   preview  https://<host>/{urlKey}/...
#   deploy   https://<host>/deploy/{urlKey}/...
# Setting a base domain switches to serving each app at its OWN host ROOT:
#   https://{label}.<baseDomain>/...
# which removes the whole class of "root-absolute asset loses the path prefix"
# bugs (e.g. Next.js images 404 in preview/deploy).
#
# The PRESENCE of ANT_PREVIEW_BASE_DOMAIN is the single switch — unset = path
# routing. Turning it on REQUIRES infra provisioned separately:
#   - wildcard DNS   *.ant-preview.your-domain.tld  AND  *.ant-deploy.your-domain.tld
#   - wildcard TLS certs for both
#   - the ingress/ALB forwarding the original Host header to ant-preview
# Setting the preview base ALSO switches deploy to subdomain routing, so both
# base domains + both wildcards must be ready together. ⚠️ If these are set
# WITHOUT the wildcard DNS/TLS provisioned, preview/deploy URLs will not resolve
# — comment them out to fall back to path routing until the infra is ready.
ANT_PREVIEW_BASE_DOMAIN=ant-preview.your-domain.tld
ANT_DEPLOY_BASE_DOMAIN=ant-deploy.your-domain.tld

# Public origin the CONTENT listener (ANT_PREVIEW_CONTENT_PORT, 4103) is
# published on — a DIFFERENT hostname from the control plane, per the origin
# split above. Read by ant-api to answer the file editor's HTML preview
# `<base href>`. Until the content-host ingress exists, leave it unset: the
# preview then browses ant-api's own /workspace mount under a CSP `sandbox`
# profile, so links work and scripts stay off. Setting it before the ingress is
# live points the preview at a host nothing answers.
# ANT_PREVIEW_CONTENT_ORIGIN=https://ant-app.your-domain.tld

# Preview-proxy debug (opt-in). ANT_PREVIEW_TRACE=1 → one warn-level trace line
# per subdomain request (host/label/owner/decision/target). OFF by default.
# ANT_PREVIEW_TRACE=1

# Preview/deploy proxy timeouts (tuning, optional — both routing modes).
#   ANT_PREVIEW_PROXY_TIMEOUT_MS (default 45000): per upstream HTTP fetch attempt.
#   ANT_PREVIEW_WS_HANDSHAKE_TIMEOUT_MS (default 20000): WS/HMR connect+handshake.
# ANT_PREVIEW_PROXY_TIMEOUT_MS=45000
# ANT_PREVIEW_WS_HANDSHAKE_TIMEOUT_MS=20000

# Custom domains (deploy-only, opt-in). Lets a user attach a domain they OWN to
# a deploy (e.g. app.mycompany.com), served in-place over auto-issued HTTPS.
# The PRESENCE of ANT_CUSTOM_DOMAIN_CNAME_TARGET is the single switch — unset =
# custom domains disabled (the register endpoint returns 503).
#
# ⚠️ Turning it on REQUIRES the NLB + Caddy on-demand-TLS layer provisioned
# separately as part of your deployment infra. Do NOT set these until that
# layer exists — otherwise the UI hands users a CNAME target that resolves to
# nothing. This layer is distinct from the subdomain wildcard above (which our
# ALB + ACM already serve); custom user domains need on-demand cert issuance.
#   - ANT_CUSTOM_DOMAIN_CNAME_TARGET (required to enable): stable hostname users
#     CNAME a SUBDOMAIN to, resolving to the NLB in front of Caddy.
#   - ANT_CUSTOM_DOMAIN_APEX_IPS (optional): comma-separated NLB elastic IPs for
#     APEX (root) domain A-records — the SAME fixed EIPs that
#     ANT_CUSTOM_DOMAIN_CNAME_TARGET resolves to. Must be static (EIP), or apex
#     A-records break when the IP rotates. Omit if apex is not supported.
#   - ANT_TLS_ASK_SECRET (optional): shared secret Caddy sends on the
#     /internal/tls-ask probe (X-Ant-Tls-Ask-Secret) — defense-in-depth atop
#     the NetworkPolicy that already restricts the endpoint to Caddy.
#     Generate: openssl rand -hex 32
ANT_CUSTOM_DOMAIN_CNAME_TARGET=ant-domains.your-domain.tld
# ANT_CUSTOM_DOMAIN_APEX_IPS=203.0.113.10,203.0.113.11
ANT_TLS_ASK_SECRET=your-tls-ask-secret-openssl-rand-hex-32

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory (opt-in)
# Set to `true` to enable codebase indexing + vector-backed RAG.
# Default is OFF — when disabled, the learn job + indexing pipeline are
# short-circuited and RAG falls back to git-changes + keyword search.
ANT_VECTOR_DB_ENABLED=false
CHROMA_URL=http://your-chroma-host:8000
EMBEDDER_URL=http://your-embedder-host:8001

# Visual Processor (background removal sidecar)
ANT_VISUAL_PROCESSOR_URL=http://your-visual-processor-host:4103