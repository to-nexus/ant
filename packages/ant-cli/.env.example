# ==========================================
# Ant CLI Configuration
# ==========================================

# Server Configuration
ANT_SERVER_MODE=local                    # 'local' | 'cloud'
ANT_CLI_PORT=4100                        # Ant CLI server port (NOT for user projects)

# ==========================================
# Workspace Configuration (물리적 격리)
# ==========================================
# 사용자 워크스페이스의 물리적 저장 위치
# 기본값: {프로젝트 루트}/workspaces (ant 소스 내부)
# 권장값: ant 소스 밖의 별도 디렉토리/디스크/마운트
#
# 예시:
# - 로컬 개발: /Users/probe/ant-workspaces
# - 프로덕션: /mnt/ant-workspaces (별도 EBS 볼륨)
# - NFS: /mnt/nfs/workspaces
# - 향후 S3: s3://ant-workspaces-prod (WorkspaceService 교체)
ANT_WORKSPACE_BASE_PATH=

# ==========================================
# Security
# ==========================================
ANT_ENCRYPTION_KEY=your-32-character-encryption-key-here

# ==========================================
# LLM Configuration
# ==========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL_NAME=claude-sonnet-4-5-20250929

# ==========================================
# Cloud Mode (Optional)
# ==========================================
CLOUD_URL=https://ant.nexus.ai

# ==========================================
# Advanced
# ==========================================
RECURSION_LIMIT=50
