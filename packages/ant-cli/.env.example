# LLM API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Model Configuration
AI_MODEL_PROVIDER=anthropic
AI_MODEL_NAME=claude-sonnet-4-5-20250929
AI_MODEL_TEMPERATURE=0.7

# Architect-specific Model Configuration (optional, defaults to AI_MODEL_*)
# ARCHITECT_MODEL_PROVIDER=anthropic
# ARCHITECT_MODEL_NAME=claude-sonnet-4-5-20250929

# Server Configuration
ANT_SERVER_MODE=local
PORT=4100
# CLOUD_URL=https://ant.nexus.ai

# Recursion Limit
RECURSION_LIMIT=30

# Encryption Key for PAT storage (DO NOT SHARE)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANT_ENCRYPTION_KEY=your_encryption_key_here
