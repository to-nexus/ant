# ============================================
# LLM Provider Configuration (REQUIRED)
# ============================================
# Provider: 'openai' or 'anthropic'
AI_MODEL_PROVIDER=anthropic

# API Keys (provide the one matching your provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Model Configuration
AI_MODEL_NAME=claude-sonnet-4-5-20250929
AI_MODEL_TEMPERATURE=0.7

# Architect-specific Model Configuration (optional, defaults to AI_MODEL_*)
# ARCHITECT_MODEL_PROVIDER=anthropic
# ARCHITECT_MODEL_NAME=claude-sonnet-4-5-20250929

# ============================================
# Server Configuration
# ============================================
# Mode: 'local' (single-user) or 'cloud' (multi-tenant with authentication)
ANT_SERVER_MODE=cloud

# Port for HTTP server (default: 4100)
ANT_CLI_PORT=4100

# Cloud mode only: Redirect URL for local mode info
CLOUD_URL=https://ant.nexus.ai

# ============================================
# Security
# ============================================
# Encryption Key for PAT storage (DO NOT SHARE)
ANT_ENCRYPTION_KEY=

# Skip authentication for localhost (development convenience)
# Set to 'true' to bypass Google OAuth when accessing from localhost
SKIP_AUTH_FOR_LOCALHOST=false

# ============================================
# Google OIDC Authentication (optional)
# ============================================
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback

# Frontend URL (for OAuth redirects)
# Leave empty if frontend and backend are on the same domain
FRONTEND_URL=

# ============================================
# Figma Integration (optional)
# ============================================
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:4100/api/figma/oauth/callback

# ============================================
# Workspace Configuration
# ============================================
# Physical workspace storage path (optional)
# If not set, auto-detects ../ant-workspaces or falls back to ./workspaces
# Uncomment and set if you want to use a custom location
# ANT_WORKSPACE_BASE_PATH=/path/to/your/workspaces

# ============================================
# Cloud IDE (Docker)
# ============================================
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=user

# IDE home directory base path (optional, defaults to {workspace}/.ide-homes)
# On macOS, do NOT use /mnt (permission denied). Leave commented to use default.
# ANT_IDE_HOME_BASE_PATH=

# ============================================
# Git Configuration (optional)
# ============================================
GIT_DEFAULT_BASE=main

# ============================================
# Development & Debugging
# ============================================
# Recursion Limit
RECURSION_LIMIT=800

# Kanban debug logs (0=off, 1=verbose)
DEBUG_KANBAN=0

# Allow all commands from LLM tooling (use with caution)
ANT_UNSAFE_ALLOW_ALL_COMMANDS=1

# ============================================
# Vector Memory (optional)
# ============================================
CHROMA_URL=http://localhost:8000
EMBEDDER_URL=http://localhost:8001
