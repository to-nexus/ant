# LLM API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI Model Configuration
AI_MODEL_PROVIDER=anthropic
AI_MODEL_NAME=claude-sonnet-4-5-20250929
AI_MODEL_TEMPERATURE=0.7

# Architect-specific Model Configuration (optional, defaults to AI_MODEL_*)
# ARCHITECT_MODEL_PROVIDER=anthropic
# ARCHITECT_MODEL_NAME=claude-sonnet-4-5-20250929

# Server Configuration
ANT_SERVER_MODE=cloud
ANT_CLI_PORT=4100
# CLOUD_URL=https://ant.nexus.ai

# Recursion Limit
RECURSION_LIMIT=800

# Git Configuration (optional)
GIT_DEFAULT_BASE=main

# Encryption Key for PAT storage (DO NOT SHARE)
ANT_ENCRYPTION_KEY=

# Figma integration
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:4100/api/figma/oauth/callback

# Workspaces
ANT_WORKSPACE_BASE_PATH=

# IDE
ANT_IDE_HOSTNAME_MODE=user

# Kanban, 0 is ignore, 1 is verbose log
DEBUG_KANBAN=0

# allowance for long-running commands from llm tooling
ANT_UNSAFE_ALLOW_ALL_COMMANDS=1

# Vector memory
CHROMA_URL=http://localhost:8000
EMBEDDER_URL=http://localhost:8001

# Cloud IDE (Docker)
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOME_BASE_PATH=/mnt/ant-ide-homes

# Google OIDC Authentication (optional)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://ant-server.crosstoken.io/api/auth/google/callback

# Frontend URL (for OAuth redirects)
# Leave empty if frontend and backend are on the same domain
FRONTEND_URL=https://ant.crosstoken.io

# Skip authentication for localhost (development convenience)
# Set to 'true' to bypass Google OAuth when accessing from localhost
SKIP_AUTH_FOR_LOCALHOST=false
