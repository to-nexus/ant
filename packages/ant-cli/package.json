{
  "name": "@ant/cli",
  "version": "1.0.0",
  "type": "module",
  "description": "ANT CLI - AI-native development framework",
  "main": "dist/index.js",
  "bin": {
    "aidev": "./dist/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:server": "PORT=4100 NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx src/composition/server.ts",
    "dev:realtime-server": "PORT=4101 NODE_ENV=development tsx src/infrastructure/realtime/start-realtime-server.ts",
    "dev:job-worker": "NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx src/infrastructure/worker/start-job-worker.ts",
    "dev:preview-server": "PORT=4102 NODE_ENV=development tsx src/infrastructure/preview/start-preview-server.ts",
    "dev:cloud": "concurrently -n api,realtime,job,preview -c cyan,magenta,yellow,green \"npm run dev:server\" \"npm run dev:realtime-server\" \"npm run dev:job-worker\" \"npm run dev:preview-server\"",
    "build": "rm -rf dist && esbuild src/composition/server.ts src/composition/job-runner.ts src/infrastructure/worker/start-job-worker.ts src/infrastructure/preview/start-preview-server.ts src/infrastructure/realtime/start-realtime-server.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external && mkdir -p dist/core/prompt dist/core/policies dist/core/data/triage dist/periphery && cp -r src/core/prompt/templates dist/core/prompt/ && cp -r src/core/policies/prompts dist/core/policies/ && cp -r src/core/data/triage/jobs dist/core/data/triage/ && cp -r src/periphery/profiles dist/periphery/",
    "start": "PORT=4100 NODE_OPTIONS='--max-old-space-size=8192' node dist/composition/server.js",
    "start:server": "PORT=4100 NODE_OPTIONS='--max-old-space-size=8192' node dist/composition/server.js",
    "start:realtime-server": "PORT=4101 node dist/infrastructure/realtime/start-realtime-server.js",
    "start:job-worker": "NODE_OPTIONS='--max-old-space-size=8192' node dist/infrastructure/worker/start-job-worker.js",
    "start:preview-server": "PORT=4102 node dist/infrastructure/preview/start-preview-server.js",
    "start:cloud": "concurrently -n api,realtime,job,preview -c cyan,magenta,yellow,green \"npm run start:server\" \"npm run start:realtime-server\" \"npm run start:job-worker\" \"npm run start:preview-server\"",
    "init:workspace": "tsx src/cli/init-cli.ts workspace",
    "init:feature": "tsx src/cli/init-cli.ts feature"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/openai": "^1.0.0",
    "@octokit/rest": "^22.0.0",
    "@types/http-proxy": "^1.17.17",
    "bullmq": "^5.66.6",
    "chromadb": "^3.0.17",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "glob": "^13.0.0",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^3.0.0",
    "ioredis": "^5.9.2",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.1",
    "langchain": "^1.0.1",
    "multer": "^2.0.2",
    "openai": "^6.14.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.3",
    "simple-git": "^3.28.0",
    "uuid": "^11.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/ioredis": "^4.28.10",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.8.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
