{
  "name": "@ant/cli",
  "version": "1.0.0",
  "description": "ANT CLI - AI-native development framework",
  "main": "dist/index.js",
  "bin": {
    "aidev": "./dist/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "NODE_ENV=development tsx src/index.ts",
    "dev:server": "NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx src/composition/server.ts",
    "build": "tsc && cp -r src/core/prompt/templates dist/core/prompt/ && cp -r src/periphery/profiles dist/periphery/",
    "start": "tsx dist/index.js",
    "start:server": "NODE_OPTIONS='--max-old-space-size=8192' tsx src/composition/server.ts",
    "init:workspace": "tsx src/cli/init-cli.ts workspace",
    "init:feature": "tsx src/cli/init-cli.ts feature"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/openai": "^1.0.0",
    "@octokit/rest": "^22.0.0",
    "chromadb": "^3.0.17",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "glob": "^13.0.0",
    "google-auth-library": "^10.5.0",
    "handlebars": "^4.7.8",
    "http-proxy-middleware": "^3.0.0",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.1",
    "langchain": "^1.0.1",
    "multer": "^2.0.2",
    "openai": "^6.14.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.3",
    "simple-git": "^3.28.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
