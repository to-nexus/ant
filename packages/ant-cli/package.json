{
  "name": "@ant/cli",
  "version": "1.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "ANT CLI - AI-native development framework",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/to-nexus/ant.git",
    "directory": "packages/ant-cli"
  },
  "bugs": "https://github.com/to-nexus/ant/issues",
  "homepage": "https://github.com/to-nexus/ant#readme",
  "scripts": {
    "test": "vitest run",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "dev:api-server": "PORT=4100 NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx src/composition/server.ts",
    "dev:realtime-server": "PORT=4101 NODE_ENV=development tsx src/infrastructure/realtime/start-realtime-server.ts",
    "dev:job-worker": "NODE_ENV=development NODE_OPTIONS='--max-old-space-size=8192' tsx src/infrastructure/worker/start-job-worker.ts",
    "dev:preview-server": "PORT=4102 NODE_ENV=development tsx src/infrastructure/preview/start-preview-server.ts",
    "dev:server": "concurrently --kill-others-on-fail -n api,realtime,job,preview -c cyan,magenta,yellow,green \"npm run dev:api-server\" \"npm run dev:realtime-server\" \"npm run dev:job-worker\" \"npm run dev:preview-server\"",
    "build": "rm -rf dist && esbuild src/composition/server.ts src/composition/job-runner.ts src/infrastructure/worker/start-job-worker.ts src/infrastructure/preview/start-preview-server.ts src/infrastructure/realtime/start-realtime-server.ts src/infrastructure/preview/static-preview-server.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --packages=external && mkdir -p dist/core/prompt dist/core/policies dist/core/data/triage && cp -r src/core/prompt/templates dist/core/prompt/ && cp -r src/core/policies/prompts dist/core/policies/ && cp -r src/core/data/triage/jobs dist/core/data/triage/ && cp -r src/core/data/agents dist/core/data/",
    "start": "PORT=4100 NODE_OPTIONS='--max-old-space-size=8192' node dist/composition/server.js",
    "start:api-server": "PORT=4100 NODE_OPTIONS='--max-old-space-size=8192' node dist/composition/server.js",
    "start:realtime-server": "PORT=4101 node dist/infrastructure/realtime/start-realtime-server.js",
    "start:job-worker": "NODE_OPTIONS='--max-old-space-size=8192' node dist/infrastructure/worker/start-job-worker.js",
    "start:preview-server": "PORT=4102 node dist/infrastructure/preview/start-preview-server.js",
    "start:server": "concurrently --kill-others-on-fail -n api,realtime,job,preview -c cyan,magenta,yellow,green \"npm run start:api-server\" \"npm run start:realtime-server\" \"npm run start:job-worker\" \"npm run start:preview-server\"",
    "init:workspace": "tsx src/cli/init-cli.ts workspace",
    "init:feature": "tsx src/cli/init-cli.ts feature",
    "resume-job": "tsx src/cli/resume-job-cli.ts",
    "scenario": "tsx scripts/verify-scenario.ts",
    "migrate:individual-org": "tsx scripts/migrate-individual-org.ts"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@ant/shared": "workspace:^",
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^1.52.0",
    "@langchain/langgraph": "^1.4.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "@types/archiver": "^7.0.0",
    "@types/http-proxy": "^1.17.17",
    "@vscode/ripgrep": "^1.18.0",
    "archiver": "^7.0.1",
    "bullmq": "^5.81.4",
    "chromadb": "^3.5.0",
    "commander": "^14.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "4.9.0",
    "dockerode": "^4.0.12",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "glob": "^13.0.6",
    "google-auth-library": "^10.9.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.3.0",
    "http-proxy": "^1.18.1",
    "ioredis": "^5.11.1",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.3.2",
    "multer": "^2.3.0",
    "openai": "^6.49.0",
    "pngjs": "^7.0.0",
    "rate-limit-redis": "^4.3.1",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "simple-git": "^3.36.0",
    "undici": "^7.29.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.2",
    "zod": "^4.5.1"
  },
  "optionalDependencies": {
    "@ant/cloud": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/handlebars": "^4.1.0",
    "@types/ioredis": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/semver": "^7.8.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "~4.1.10"
  }
}
