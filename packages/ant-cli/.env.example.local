# ===========================================
# Ant CLI - LOCAL MODE
# ===========================================
# Local development with auto-login (local:local).
# Run ant-api, ant-job, ant-preview as separate processes.
#
# Startup: Redis -> ant-api -> ant-job -> ant-preview
#   docker run -d -p 6379:6379 redis
#   pnpm dev:server
#   pnpm dev:worker

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

# Server Mode: local (auto-login) | cloud (OAuth)
ANT_SERVER_MODE=local

# Redis (Required)
ANT_REDIS_URL=redis://localhost:6379

# Workspace Storage (Local directory)
ANT_WORKSPACE_BASE_PATH=~/ant-workspaces

# Encryption Key (generate: openssl rand -hex 32)
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# LLM API
AI_MODEL_NAME=claude-sonnet-4-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# ┌─────────────────────────────────────────┐
# │           API SERVER (ant-api)          │
# └─────────────────────────────────────────┘

ANT_CLI_PORT=4000

# Preview Worker URLs (comma-separated)
ANT_PREVIEW_WORKERS=http://localhost:8080

# Google OAuth (not required for local mode)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# FRONTEND_URL=http://localhost:4200
# SKIP_AUTH_FOR_LOCALHOST=true

# IDE Orchestration
# Not set: Docker | Set: Kubernetes
# ANT_K8S_NAMESPACE=ant-ide
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
# ANT_IDE_HOSTNAME_MODE=proxy

# Vector Memory (Optional)
# CHROMA_URL=http://localhost:8000
# EMBEDDER_URL=http://localhost:8001

# Figma Integration (Optional)
# FIGMA_CLIENT_ID=your-figma-client-id
# FIGMA_CLIENT_SECRET=your-figma-client-secret
# FIGMA_REDIRECT_URI=http://localhost:4000/api/auth/figma/callback

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

ANT_WORKER_CONCURRENCY=3
RECURSION_LIMIT=20
GIT_DEFAULT_BASE=main
# ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# ┌─────────────────────────────────────────┐
# │       PREVIEW WORKER (ant-preview)      │
# └─────────────────────────────────────────┘

ANT_PREVIEW_WORKER_PORT=8080

# ┌─────────────────────────────────────────┐
# │             DEBUG (Optional)            │
# └─────────────────────────────────────────┘

# DEBUG_KANBAN=false
