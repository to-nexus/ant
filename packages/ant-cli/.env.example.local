# ===========================================
# Ant CLI - LOCAL MODE
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON + PREVIEW SERVER sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

# All four values below have working local-mode defaults — uncomment only to
# override. (Cloud mode: ANT_REDIS_URL is REQUIRED, there is no default.)
# ANT_SERVER_MODE=local
# ANT_REDIS_URL=redis://localhost:16379
# ANT_WORKSPACE_BASE_PATH=/absolute/path     # default: sibling ../ant-workspaces, else <cwd>/workspaces (no ~ expansion)
# ANT_ENCRYPTION_KEY=<64 hex chars>          # default: auto-generated to <workspaceRoot>/.ant/encryption.key
#                                            # to pin manually: openssl rand -hex 32

# JWT Authentication — not needed in local mode (fixed `local:local` tenant).
# Cloud: see the AUTH KEYS section in .env.example.cloud (scoped per service).

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# ── System default models ─────────────────────────────────────────────────
# Which ABSTRACT model each job/node default binds to, as "<provider>:<tier>".
# A tier names one provider's model family above version; the tier → concrete id
# map is code-owned (MODEL_REGISTRY in @ant/shared), because that changes when a
# provider ships a model. What you set here is the binding, so moving the code job
# onto GLM or commit messages onto Haiku needs no rebuild.
#
# Available tiers:
#   anthropic : sonnet opus haiku
#   openai    : sol terra luna
#   google    : pro flash proImage flashImage
#   deepseek  : pro flash
#   glm       : flagship fast
#   kimi      : flagship code codeHighspeed
#
# A per-project override in the UI still wins over these. An unknown / malformed
# value is logged and ignored in favour of the built-in binding. Leave commented to
# use the built-ins shown. Requires the matching provider API key below.
# ANT_DEFAULT_MODEL_DESIGN=anthropic:sonnet
# ANT_DEFAULT_MODEL_DESIGN_DECOMPOSE=anthropic:sonnet
# ANT_DEFAULT_MODEL_DESIGN_PLAN=anthropic:opus
# ANT_DEFAULT_MODEL_DESIGN_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE_DECOMPOSE=anthropic:opus
# ANT_DEFAULT_MODEL_CODE_PLAN=anthropic:sonnet
# ANT_DEFAULT_MODEL_CODE_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_LEARN=anthropic:sonnet
# ANT_DEFAULT_MODEL_PLAN=anthropic:sonnet
# ANT_DEFAULT_MODEL_PLAN_PLAN=anthropic:opus
# ANT_DEFAULT_MODEL_PLAN_EXECUTE=anthropic:sonnet
# ANT_DEFAULT_MODEL_REVIEWER=anthropic:opus
# ANT_DEFAULT_MODEL_DOC=anthropic:opus
# Auxiliary one-shot call: the ant-authored commit message.
# ANT_DEFAULT_MODEL_UNIVERSAL=anthropic:sonnet
# ANT_DEFAULT_MODEL_COMMIT=anthropic:sonnet
# Visual/creator job. sketch + render MUST bind to image-generation tiers
# (google:proImage / google:flashImage) — a text tier there is rejected.
# ANT_DEFAULT_MODEL_VISUAL=google:flash
# ANT_DEFAULT_MODEL_VISUAL_DIRECT=google:pro
# ANT_DEFAULT_MODEL_VISUAL_EXPLAIN=google:pro
# ANT_DEFAULT_MODEL_VISUAL_ENGRAVE=google:pro
# ANT_DEFAULT_MODEL_VISUAL_SKETCH=google:flashImage
# ANT_DEFAULT_MODEL_VISUAL_RENDER=google:proImage
# Used only when a call maps to no slot at all.
# ANT_DEFAULT_MODEL_FALLBACK=anthropic:sonnet
# Fallback only — per-call sampling policy is the SSOT
# (src/core/ports/llmSampling.ts LLM_TEMPERATURE); this value applies
# only to call sites that pass no explicit temperature.
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DeepSeek — OpenAI-compatible API. Optional; third-party China-hosted provider,
# see the in-app consent notice. Uncomment and set to enable DeepSeek models.
# DEEPSEEK_API_KEY=your-deepseek-api-key
# GLM (Zhipu / Z.ai) — OpenAI-compatible API. Optional; third-party China-hosted
# provider, see the in-app consent notice. Uncomment and set to enable GLM models.
# GLM_API_KEY=your-glm-api-key
# Kimi (Moonshot AI) — OpenAI-compatible API. Optional; third-party China-hosted
# provider, see the in-app consent notice. Uncomment and set to enable Kimi models.
# KIMI_API_KEY=your-kimi-api-key

# Endpoint overrides for the OpenAI-compatible providers — route the registered
# model ids through your own gateway (LiteLLM / vLLM / OpenRouter). These do NOT
# add arbitrary-model support (MODEL_REGISTRY is code-owned).
# ANT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANT_GLM_BASE_URL=https://api.z.ai/api/paas/v4
# ANT_KIMI_BASE_URL=https://api.moonshot.ai/v1

# Per-job sampling overrides. Both are FALLBACKS only — per-call policy is the SSOT
# (src/core/ports/llmSampling.ts). {JOB} is the upper-cased agent job, e.g.
# CODE_MODEL_TEMPERATURE / DESIGN_MODEL_MAX_TOKENS.
# CODE_MODEL_TEMPERATURE=0.7
# CODE_MODEL_MAX_TOKENS=16000

# Operator hard opt-outs for provider reasoning. Only these providers expose one.
# DEEPSEEK_THINKING=disabled
# GLM_THINKING=disabled
# OPENAI_REASONING_EFFORT=low|medium|high|xhigh

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# Google OAuth + FE/CORS origins
# Not required for local mode — local skips OAuth and accepts loopback
# origins automatically. In cloud mode:
#   - FRONTEND_URL: primary FE origin (CORS allowlist + OAuth redirect base).
#     In same-origin deployments it doubles as the BE host fallback used to
#     derive GOOGLE_REDIRECT_URI when the latter is unset.
#   - ANT_CORS_ORIGINS: additional FE origins as CSV (split-host / dev).
#   - GOOGLE_REDIRECT_URI: only required when FE and BE live on different
#     hosts (split-host); otherwise derived from FRONTEND_URL.
# Cloud mode with both FRONTEND_URL and ANT_CORS_ORIGINS unset will surface
# a `[CORS]` startup warn so silent split-host failures don't reach prod.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback
# FRONTEND_URL=http://localhost:4200
# ANT_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# IDE Orchestration (Docker; set ANT_K8S_NAMESPACE for K8s)
# ANT_K8S_NAMESPACE=ant-ide
# ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
# ANT_IDE_HOSTNAME_MODE=user

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용
ANT_API_URL=http://localhost:4100

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
# Calibrated for tool-call file authoring (each write round = 2 graph steps)
RECURSION_LIMIT=300
GIT_DEFAULT_BASE=main
# ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# ┌─────────────────────────────────────────┐
# │ CHILD ISOLATION (ant-job & ant-preview) │
# └─────────────────────────────────────────┘

# CLOUD-ONLY — OS identity for user-authored children (run_command, preview
# dev servers, installs). Cloud mode is FAIL-CLOSED without these; local mode
# has no second account and skips the gate, so leave them unset here.
# Values name the unprivileged account the image/host provides (cloud image:
# ant-child uid 10001, shared group gid 1000) and the spawning process needs
# uid-change privilege (CAP_SETUID) — see .env.example.cloud for the full notes.
# ANT_CHILD_UID=10001   # (cloud only — leave unset locally)
# ANT_CHILD_GID=1000    # (cloud only — leave unset locally)
# ANT_CHILD_UMASK=002   # (cloud only — image default; override only if yours differs)

# ┌─────────────────────────────────────────┐
# │        PREVIEW SERVER (ant-preview)     │
# └─────────────────────────────────────────┘

# Per-app subdomain routing is CLOUD-ONLY — it needs wildcard DNS + TLS that
# local dev does not have. Local always uses path routing
# (http://localhost:4200/{urlKey}/... and /deploy/{urlKey}/...), so leave these
# unset. See .env.example.cloud for the cloud setup.
# Values shown are illustrative (mirror .env.example.cloud) — keep them COMMENTED
# locally. Uncommenting has no benefit without the cloud wildcard/NLB infra.
# ANT_PREVIEW_BASE_DOMAIN=ant-preview.your-domain.tld   # (cloud only — leave unset locally)
# ANT_DEPLOY_BASE_DOMAIN=ant-deploy.your-domain.tld     # (cloud only — leave unset locally)

# Preview-proxy debug (opt-in). ANT_PREVIEW_TRACE=1 → one trace line per subdomain
# request. No-op locally (subdomain path only) — here for parity with the cloud example.
# ANT_PREVIEW_TRACE=1                                # (cloud/subdomain-mode only — no-op locally)

# Preview/deploy proxy timeouts (tuning, optional — apply in local path mode too).
#   ANT_PREVIEW_PROXY_TIMEOUT_MS (default 45000): per upstream HTTP fetch attempt.
#   ANT_PREVIEW_WS_HANDSHAKE_TIMEOUT_MS (default 20000): WS/HMR connect+handshake.
# ANT_PREVIEW_PROXY_TIMEOUT_MS=45000
# ANT_PREVIEW_WS_HANDSHAKE_TIMEOUT_MS=20000

# Custom domains are CLOUD-ONLY (need the NLB + Caddy on-demand-TLS layer).
# Leave unset locally — registration is refused when the CNAME target is absent.
# ANT_CUSTOM_DOMAIN_CNAME_TARGET=ant-domains.your-domain.tld      # (cloud only)
# ANT_CUSTOM_DOMAIN_APEX_IPS=203.0.113.10,203.0.113.11          # (cloud only)
# ANT_TLS_ASK_SECRET=your-tls-ask-secret-openssl-rand-hex-32  # (cloud only)

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory (opt-in)
# Set to `true` AND start ChromaDB + embedder (`pnpm dev:infra:vector`)
# to enable codebase indexing, the architect/learn job, and vector-backed
# RAG. Default is OFF — RAG falls back to git-changes + keyword search.
# ANT_VECTOR_DB_ENABLED=true
# CHROMA_URL=http://localhost:8000
# EMBEDDER_URL=http://localhost:8001

# Visual Processor (background removal sidecar)
# ANT_VISUAL_PROCESSOR_URL=http://localhost:4104

# ┌─────────────────────────────────────────┐
# │       FE BUILD-TIME (packages/ant-ui)   │
# └─────────────────────────────────────────┘
#
# These belong in the FE build environment (Vite reads VITE_* at build time
# from packages/ant-ui/.env.* or `vite build` envs), not in this BE .env.
# Documented here for cross-reference only.
#
# VITE_CLOUD_BACKEND_BASE — drives the FE launch-mode selector behavior:
#   - unset                              → Persona A (OSS local-only).
#                                          Cloud toggle disabled with tooltip.
#   - external origin (different host)   → Persona B (OSS + managed).
#                                          Cloud toggle navigates to that origin.
#   - same origin as window.location     → Persona C (cloud self-host).
#                                          Cloud toggle flips in-app state.
