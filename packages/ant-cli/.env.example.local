# ===========================================
# Ant CLI - LOCAL MODE
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON + PREVIEW SERVER sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=local
ANT_REDIS_URL=redis://localhost:16379
ANT_WORKSPACE_BASE_PATH=~/ant-workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# JWT Authentication
# Not required for local mode — local sessions use the fixed `local:local`
# tenant. Leave commented unless ANT_SERVER_MODE=cloud.
# ANT_JWT_SECRET=your-jwt-secret-at-least-32-characters

# ┌─────────────────────────────────────────┐
# │                LLM API                  │
# └─────────────────────────────────────────┘

AI_MODEL_NAME=claude-sonnet-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key
# DeepSeek — OpenAI-compatible API. Optional; third-party China-hosted provider,
# see the in-app consent notice. Uncomment and set to enable DeepSeek models.
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ┌─────────────────────────────────────────┐
# │        LLM API (ant-api & ant-job)      │
# └─────────────────────────────────────────┘

# Google OAuth + FE/CORS origins
# Not required for local mode — local skips OAuth and accepts loopback
# origins automatically. In cloud mode:
#   - FRONTEND_URL: primary FE origin (CORS allowlist + OAuth redirect base).
#     In same-origin deployments it doubles as the BE host fallback used to
#     derive GOOGLE_REDIRECT_URI when the latter is unset.
#   - ANT_CORS_ORIGINS: additional FE origins as CSV (split-host / dev).
#   - GOOGLE_REDIRECT_URI: only required when FE and BE live on different
#     hosts (split-host); otherwise derived from FRONTEND_URL.
# Cloud mode with both FRONTEND_URL and ANT_CORS_ORIGINS unset will surface
# a `[CORS]` startup warn so silent split-host failures don't reach prod.
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback
# FRONTEND_URL=http://localhost:4200
# ANT_CORS_ORIGINS=http://localhost:5173,https://app.example.com

# IDE Orchestration (Docker; set ANT_K8S_NAMESPACE for K8s)
# ANT_K8S_NAMESPACE=ant-ide
# ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
# ANT_IDE_HOSTNAME_MODE=user

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용
ANT_API_URL=http://localhost:4100

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
RECURSION_LIMIT=100
GIT_DEFAULT_BASE=main
# ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# ┌─────────────────────────────────────────┐
# │        PREVIEW SERVER (ant-preview)     │
# └─────────────────────────────────────────┘

# Per-app subdomain routing is CLOUD-ONLY — it needs wildcard DNS + TLS that
# local dev does not have. Local always uses path routing
# (http://localhost:4200/{urlKey}/... and /deploy/{urlKey}/...), so leave these
# unset. See .env.example.cloud for the cloud setup.
# Values shown are illustrative (mirror .env.example.cloud) — keep them COMMENTED
# locally. Uncommenting has no benefit without the cloud wildcard/NLB infra.
# ANT_PREVIEW_BASE_DOMAIN=ant-preview.cross.nexus   # (cloud only — leave unset locally)
# ANT_DEPLOY_BASE_DOMAIN=ant-deploy.cross.nexus     # (cloud only — leave unset locally)

# Custom domains are CLOUD-ONLY (need the NLB + Caddy on-demand-TLS layer).
# Leave unset locally — registration is refused when the CNAME target is absent.
# ANT_CUSTOM_DOMAIN_CNAME_TARGET=ant-domains.cross.nexus      # (cloud only)
# ANT_CUSTOM_DOMAIN_APEX_IPS=3.34.11.22,13.125.33.44          # (cloud only)
# ANT_TLS_ASK_SECRET=your-tls-ask-secret-openssl-rand-hex-32  # (cloud only)

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory (opt-in)
# Set to `true` AND start ChromaDB + embedder (`pnpm dev:infra:vector`)
# to enable codebase indexing, the architect/learn job, and vector-backed
# RAG. Default is OFF — RAG falls back to git-changes + keyword search.
# ANT_VECTOR_DB_ENABLED=true
# CHROMA_URL=http://localhost:8000
# EMBEDDER_URL=http://localhost:8001

# Visual Processor (background removal sidecar)
# ANT_VISUAL_PROCESSOR_URL=http://localhost:4103

# ┌─────────────────────────────────────────┐
# │       FE BUILD-TIME (packages/ant-ui)   │
# └─────────────────────────────────────────┘
#
# These belong in the FE build environment (Vite reads VITE_* at build time
# from packages/ant-ui/.env.* or `vite build` envs), not in this BE .env.
# Documented here for cross-reference only.
#
# VITE_CLOUD_BACKEND_BASE — drives the FE launch-mode selector behavior:
#   - unset                              → Persona A (OSS local-only).
#                                          Cloud toggle disabled with tooltip.
#   - external origin (different host)   → Persona B (OSS + managed).
#                                          Cloud toggle navigates to that origin.
#   - same origin as window.location     → Persona C (cloud self-host).
#                                          Cloud toggle flips in-app state.
