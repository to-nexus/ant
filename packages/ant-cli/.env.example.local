# ===========================================
# Ant CLI - LOCAL MODE
# ===========================================
#
# Usage per service:
#   ant-api     : COMMON + LLM API + API SERVER sections
#   ant-realtime: COMMON sections
#   ant-job     : COMMON + LLM API + JOB WORKER sections
#   ant-preview : COMMON sections

# ┌─────────────────────────────────────────┐
# │           COMMON (All Servers)          │
# └─────────────────────────────────────────┘

ANT_SERVER_MODE=local
ANT_REDIS_URL=redis://localhost:6379
ANT_WORKSPACE_BASE_PATH=~/ant-workspaces
ANT_ENCRYPTION_KEY=your-64-char-hex-key

# ┌─────────────────────────────────────────┐
# │                LLM API                  │
# └─────────────────────────────────────────┘

AI_MODEL_NAME=claude-sonnet-4-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# ┌─────────────────────────────────────────┐
# │           API SERVER (ant-api)          │
# └─────────────────────────────────────────┘

# Google OAuth (not required for local mode)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback
# FRONTEND_URL=http://localhost:4200
# SKIP_AUTH_FOR_LOCALHOST=true

# IDE Orchestration (Docker; set ANT_K8S_NAMESPACE for K8s)
# ANT_K8S_NAMESPACE=ant-ide
# ANT_EFS_PVC_NAME=ant-workspaces-pvc
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
# ANT_IDE_HOSTNAME_MODE=user

# Debug
# DEBUG_KANBAN=false

# ┌─────────────────────────────────────────┐
# │          JOB WORKER (ant-job)           │
# └─────────────────────────────────────────┘

# ant-job → ant-api HTTP 호출용
ANT_API_URL=http://localhost:4100

ANT_WORKER_CONCURRENCY=3
ANT_TASK_CONCURRENCY=4
RECURSION_LIMIT=800
GIT_DEFAULT_BASE=main
# ANT_UNSAFE_ALLOW_ALL_COMMANDS=false

# Ask System Debug
ASK_DEBUG=true
ASK_RECURSION_LIMIT=100

# ┌─────────────────────────────────────────┐
# │          OPTIONAL SERVICES              │
# └─────────────────────────────────────────┘

# Vector Memory
# CHROMA_URL=http://localhost:8000
# EMBEDDER_URL=http://localhost:8001

# Figma Integration
# FIGMA_CLIENT_ID=your-figma-client-id
# FIGMA_CLIENT_SECRET=your-figma-client-secret
# FIGMA_REDIRECT_URI=http://localhost:4100/api/auth/figma/callback
