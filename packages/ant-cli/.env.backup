# ===========================================
# Ant CLI - CLOUD MODE (Development)
# ===========================================
# Distributed: ant-api, ant-job, ant-preview run separately.
#
# Startup order:
#   1. Redis: docker run -d -p 6379:6379 redis
#   2. API: npm run dev:server
#   3. Job Worker: npm run dev:worker
#   4. Preview Worker: npm run dev:preview-worker

# ===========================================
# Server Mode
# ===========================================
ANT_SERVER_MODE=cloud

# ===========================================
# Required Infrastructure
# ===========================================
ANT_REDIS_URL=redis://localhost:6379
ANT_PREVIEW_WORKERS=http://localhost:8080

# ===========================================
# Workspace Path
# ===========================================
ANT_WORKSPACE_BASE_PATH=/Users/probe/dev/ant-workspaces

# ===========================================
# LLM API
# ===========================================
AI_MODEL_NAME=claude-sonnet-4-5
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=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
OPENAI_API_KEY=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

# ===========================================
# Encryption Key
# ===========================================
ANT_ENCRYPTION_KEY=23a04c4802228531de5fdc29176d5c833320f56b487129a1fc33bdc5a2b1d8dd

# ===========================================
# Job Execution
# ===========================================
RECURSION_LIMIT=800
GIT_DEFAULT_BASE=main
ANT_UNSAFE_ALLOW_ALL_COMMANDS=1

# ===========================================
# API Server (ant-api)
# ===========================================
ANT_CLI_PORT=4100

# Google OAuth
GOOGLE_CLIENT_ID=893150301148-3n8se6ad6segikf2sed3gd966i77nge5.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback
FRONTEND_URL=http://localhost:4200
SKIP_AUTH_FOR_LOCALHOST=true

# ===========================================
# Job Worker (ant-job)
# ===========================================
ANT_WORKER_CONCURRENCY=3

# ===========================================
# Preview Worker (ant-preview)
# ===========================================
ANT_PREVIEW_PORT=4102

# ===========================================
# IDE
# ===========================================
# Not set: Docker (current)
# Set: Kubernetes
# ANT_K8S_NAMESPACE=ant-ide
ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=user

# ===========================================
# Vector Memory (Optional)
# ===========================================
CHROMA_URL=http://localhost:8000
EMBEDDER_URL=http://localhost:8001

# ===========================================
# Figma Integration (Optional)
# ===========================================
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# FIGMA_REDIRECT_URI=

# ===========================================
# Debug
# ===========================================
DEBUG_KANBAN=0
