# =============================================
# Ant CLI - LOCAL MODE Configuration
# =============================================
# Single server runs all features (only ant-api needed)
# Usage: cp .env.example.local .env
# =============================================

# ======================
# SERVER
# ======================

ANT_SERVER_MODE=local
ANT_CLI_PORT=4100

# ======================
# LLM API (Required)
# ======================

# Provider auto-detected from model name (claude-* → anthropic, gpt-* → openai)
AI_MODEL_NAME=claude-sonnet-4-5-20250929
AI_MODEL_TEMPERATURE=0.7
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ======================
# STORAGE
# ======================

# Optional - auto-detected if not set
# ANT_WORKSPACE_BASE_PATH=/path/to/workspaces

# ======================
# SECURITY
# ======================

# Encryption key for credentials (GitHub PAT, etc.)
# Generate with: openssl rand -hex 32
# If not set, auto-generated and stored in workspaces/.ant/encryption.key
ANT_ENCRYPTION_KEY=

# ======================
# CLOUD IDE (Docker)
# ======================

ANT_IDE_IMAGE=gitpod/openvscode-server:latest
ANT_IDE_HOSTNAME_MODE=user

# ======================
# VECTOR MEMORY (Optional)
# ======================

CHROMA_URL=http://localhost:8000
EMBEDDER_URL=http://localhost:8001

# ======================
# GIT
# ======================

GIT_DEFAULT_BASE=main

# ======================
# DEBUG
# ======================

RECURSION_LIMIT=800
DEBUG_KANBAN=0
ANT_UNSAFE_ALLOW_ALL_COMMANDS=1
