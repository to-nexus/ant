# ===========================================
# ANT CLI Environment Configuration
# ===========================================
# Copy this file to .env and modify values

# Server Mode
# - local: No authentication, single-user mode
# - cloud: Full authentication, multi-tenant mode
ANT_SERVER_MODE=cloud

# Server Ports
ANT_CLI_PORT=4100
ANT_REALTIME_PORT=4101

# Redis URL (Required for cloud mode)
ANT_REDIS_URL=redis://localhost:6379

# Preview Workers (Required)
# Comma-separated list of preview worker URLs
ANT_PREVIEW_WORKERS=http://localhost:8080

# Workspace Path
# Physical storage path for workspaces
ANT_WORKSPACE_BASE_PATH=/path/to/workspaces

# Kubernetes IDE (Optional)
# Set this to enable K8s-based Cloud IDE instead of Docker
# ANT_K8S_NAMESPACE=ant-ide

# Encryption Key (Required for cloud mode)
# Generate with: openssl rand -hex 32
ANT_ENCRYPTION_KEY=your-64-char-hex-key-here

# LangGraph Recursion Limit
RECURSION_LIMIT=800

# Web Search (Tavily) — used by planner for PRD research
# Get your API key at https://tavily.com
# ANT_TAVILY_API_KEY=tvly-your-tavily-api-key

# Google OAuth (Optional, for cloud mode)
# GOOGLE_CLIENT_ID=your-client-id
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4100/api/auth/google/callback
