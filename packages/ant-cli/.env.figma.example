# ===========================================
# Figma OAuth 2.0 Configuration
# ===========================================
# 
# 1. Create OAuth app: https://www.figma.com/developers/apps
# 2. Get Client ID and Client Secret
# 3. Add Redirect URI: http://localhost:54112/api/figma/oauth/callback
# 4. Select Scopes: file_content:read
# 5. Copy values here:

FIGMA_CLIENT_ID=your_figma_client_id_here
FIGMA_CLIENT_SECRET=your_figma_client_secret_here
FIGMA_REDIRECT_URI=http://localhost:54112/api/figma/oauth/callback

# Optional: If you have MCP token
# FIGMA_MCP_TOKEN=figd_...
# FIGMA_MCP_SERVER_URL=https://mcp.figma.com
