# ===========================================
# Ant Site - Development Build
# ===========================================
#
# Local development: this Next.js site runs on port 4300, while the ant-ui app
# (Vite) runs on port 4200 — separate origins. API/realtime calls go same-origin
# (relative paths); cross-origin overrides go in `.env.development.local`
# (gitignored) when pointing at a remote backend.

# API server base URL — empty = same-origin (relative paths).
# Override in .env.development.local when testing with a remote backend.
NEXT_PUBLIC_API_BASE=

# ant-ui app origin for this site's "Go to App" / hero / pricing CTAs. In local
# dev the app runs on a DIFFERENT origin (Vite, 4200) than this site (4300), so
# a relative /app/ link would dead-end on 4300. Point at ant-ui's origin so the
# CTA is absolute. Keep in sync with ant-ui's port (ANT_UI_PORT, default 4200).
NEXT_PUBLIC_APP_BASE=http://localhost:4200

# Canonical managed-cloud API origin for the pricing catalog. The marketing
# site always fetches cloud prices from here (inline, not a link) regardless of
# the build mode. Point at a local backend in .env.development.local to see
# live prices in local dev (the prod origin is usually CORS-blocked from localhost).
NEXT_PUBLIC_CLOUD_API_BASE=https://ant-server.cross.nexus

# Managed ANT Cloud app origin — the target for the /cloud page's "Try ANT Cloud"
# CTA. Always points at the real cloud app (like CLOUD_API_BASE above) so a
# local-mode build still advertises the hosted product, not localhost/app.
# Origin only; the `/app/` path is appended in code.
NEXT_PUBLIC_CLOUD_APP_BASE=https://ant.cross.nexus
