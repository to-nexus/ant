# ===========================================
# Ant Site - Cloud Mode (Production Build)
# ===========================================
#
# Split-host production deployment: FE and API live on different hosts,
# so absolute URLs are baked into the HTML/JS at build time. Leave empty
# only when transitioning to a single-origin (reverse-proxied) layout.

# API server base URL for cross-origin auth calls. Production split-host SSOT.
# This is set at build time and embedded in static files.
NEXT_PUBLIC_API_BASE=https://ant-server.cross.nexus

# Canonical managed-cloud API origin for the pricing catalog. The marketing
# site always fetches cloud prices from here (inline, not a link). For a
# self-host OSS build, keep this pointed at the managed-cloud origin so the
# pricing section still shows real cloud prices.
NEXT_PUBLIC_CLOUD_API_BASE=https://ant-server.cross.nexus

# Managed ANT Cloud app origin — the target for the /cloud page's "Try ANT Cloud"
# CTA (and its pricing-plan CTAs). This is the UI host (CloudFront-backed
# ant.cross.nexus), distinct from the API host above. Origin only; the `/app/`
# path is appended in code. Unset ⇒ those CTAs resolve to nothing (no source
# fallback); set it to advertise the cloud app.
NEXT_PUBLIC_CLOUD_APP_BASE=https://ant.cross.nexus

# ant-ui app origin for the same-origin "Go to App" / hero / pricing CTAs. In
# production the site and app share one CloudFront origin (site at /*, app at
# /app/*), so leave this EMPTY ⇒ those CTAs stay relative (/app/), same-origin.
# Set it only if the app is ever split onto a distinct origin from this site.
NEXT_PUBLIC_APP_BASE=
