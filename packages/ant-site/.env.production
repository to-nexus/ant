# ===========================================
# Ant Site - Cloud Mode (Production Build)
# ===========================================
#
# Split-host production deployment: FE and API live on different hosts,
# so absolute URLs are baked into the HTML/JS at build time. Leave empty
# only when transitioning to a single-origin (reverse-proxied) layout.

# API server base URL for cross-origin auth calls. Production split-host SSOT.
# This is set at build time and embedded in static files.
NEXT_PUBLIC_API_BASE=https://ant-server.crosstoken.io

# Optional: override the "Get Started" / "Go to App" target. When unset,
# ant-site links to `/app/` on the same origin (via the Vite proxy in dev,
# the static export's app/ shell in prod).
# NEXT_PUBLIC_ANT_UI_URL=https://ant.crosstoken.io/app/
