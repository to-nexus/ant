      "description": "Todo 삭제 기능 테스트",
      "prompt": "삭제 기능이 올바르게 동작하는지 검증",
      "testCases": [
        {
          "id": "test-delete",
          "description": "Todo 삭제",
          "assertions": [
            "const todos = [{ id: '1', text: 'Test' }, { id: '2', text: 'Test2' }]",
            "const filtered = todos.filter(t => t.id !== '1')",
            "assert(filtered.length === 1)",
            "assert(filtered[0].id === '2')"
          ],
          "timeout": 2000
        }
      ],
      "metadata": {
        "difficulty": "easy",
        "tags": ["todo", "delete", "filter"],
        "source": "project"
      }
    },
    {
      "id": "filter-todos",
      "description": "Todo 필터링 기능 테스트",
      "prompt": "All/Active/Completed 필터링 검증",
      "testCases": [
        {
          "id": "test-filter-all",
          "description": "All 필터",
          "assertions": [
            "const todos = [{ id: '1', completed: false }, { id: '2', completed: true }]",
            "const all = todos",
            "assert(all.length === 2)"
          ],
          "timeout": 2000
        },
        {
          "id": "test-filter-active",
          "description": "Active 필터",
          "assertions": [
            "const todos = [{ id: '1', completed: false }, { id: '2', completed: true }]",
            "const active = todos.filter(t => !t.completed)",
            "assert(active.length === 1)",
            "assert(active[0].id === '1')"
          ],
          "timeout": 2000
        },
        {
          "id": "test-filter-completed",
          "description": "Completed 필터",
          "assertions": [
            "const todos = [{ id: '1', completed: false }, { id: '2', completed: true }]",
            "const completed = todos.filter(t => t.completed)",
            "assert(completed.length === 1)",
            "assert(completed[0].id === '2')"
          ],
          "timeout": 2000
        }
      ],
