    {
      "id": "toggle-complete",
      "description": "Todo 완료 상태 토글 테스트",
      "prompt": "완료/미완료 토글 기능 검증",
      "testCases": [
        {
          "id": "test-toggle",
          "description": "완료 상태 변경",
          "assertions": [
            "let completed = false",
            "completed = !completed",
            "assert(completed === true)",
            "completed = !completed",
            "assert(completed === false)"
          ],
          "timeout": 2000
        }
      ],
      "metadata": {
        "difficulty": "easy",
        "tags": ["todo", "toggle", "state"],
        "source": "project"
