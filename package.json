{
  "name": "ant-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ANT (AI-Native Transformation) - Monorepo",
  "scripts": {
    "dev": "concurrently \"pnpm dev:cli\" \"pnpm dev:ui\" \"pnpm dev:ide\"",
    "dev:cli": "pnpm --filter @ant/cli dev:server",
    "dev:cli-local": "ANT_SERVER_MODE=local PORT=4000 pnpm --filter @ant/cli dev:server",
    "dev:ui": "pnpm --filter @ant/ui dev",
    "dev:ide": "pnpm --filter @ant/ide dev",
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter @ant/cli build",
    "build:cli-local": "ANT_SERVER_MODE=local PORT=4000 pnpm --filter @ant/cli build",
    "build:ui": "pnpm --filter @ant/ui build",
    "start:ide": "pnpm --filter @ant/ide start",
    "init:workspace": "pnpm --filter @ant/cli init:workspace",
    "init:feature": "pnpm --filter @ant/cli init:feature",
    "migrate:workspace": "ts-node scripts/migrate-workspace-structure.ts",
    "migrate:workspace:dry-run": "ts-node scripts/migrate-workspace-structure.ts -- --dry-run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "argon2",
      "code-server",
      "esbuild"
    ]
  }
}
