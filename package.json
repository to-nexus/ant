{
  "name": "ant",
  "version": "1.0.0",
  "private": true,
  "description": "ANT (AI-Native Transformation) - Monorepo",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:ui": "pnpm --filter @ant/ui dev",
    "dev:site": "pnpm --filter @ant/site dev",
    "dev:server": "ANT_REDIS_URL=redis://localhost:16379 ANT_PREVIEW_WORKERS=http://localhost:8080 pnpm --filter @ant/cli dev:server",
    "dev:all": "concurrently -n cli,ui,site -c cyan,magenta,green \"pnpm dev:server\" \"pnpm dev:ui\" \"pnpm dev:site\"",
    "dev:api-server": "ANT_REDIS_URL=redis://localhost:16379 ANT_PREVIEW_WORKERS=http://localhost:8080 pnpm --filter @ant/cli dev:api-server",
    "dev:realtime-server": "ANT_REDIS_URL=redis://localhost:16379 ANT_PREVIEW_WORKERS=http://localhost:8080 pnpm --filter @ant/cli dev:realtime-server",
    "dev:job-worker": "ANT_REDIS_URL=redis://localhost:16379 ANT_PREVIEW_WORKERS=http://localhost:8080 pnpm --filter @ant/cli dev:job-worker",
    "dev:preview-server": "ANT_REDIS_URL=redis://localhost:16379 ANT_PREVIEW_WORKERS=http://localhost:8080 pnpm --filter @ant/cli dev:preview-server",
    "dev:infra": "concurrently \"docker compose -f packages/ant-cli/src/periphery/integrations/cache-memory/docker-compose.yml up -d\" \"docker compose -f packages/ant-cli/src/periphery/integrations/vector-memory/docker-compose.yml up -d\" \"docker compose -f packages/ant-cli/src/periphery/integrations/visual-processor/docker-compose.yml up -d\"",
    "dev:infra:down": "docker compose -f packages/ant-cli/src/periphery/integrations/cache-memory/docker-compose.yml down && docker compose -f packages/ant-cli/src/periphery/integrations/vector-memory/docker-compose.yml down && docker compose -f packages/ant-cli/src/periphery/integrations/visual-processor/docker-compose.yml down",
    "dev:infra:visual": "docker compose -f packages/ant-cli/src/periphery/integrations/visual-processor/docker-compose.yml up -d",
    "dev:infra:visual:down": "docker compose -f packages/ant-cli/src/periphery/integrations/visual-processor/docker-compose.yml down",
    "dev:infra:redis": "docker compose -f packages/ant-cli/src/periphery/integrations/cache-memory/docker-compose.yml up -d",
    "dev:infra:redis:down": "docker compose -f packages/ant-cli/src/periphery/integrations/cache-memory/docker-compose.yml down",
    "dev:infra:vector": "docker compose -f packages/ant-cli/src/periphery/integrations/vector-memory/docker-compose.yml up -d",
    "dev:infra:vector:down": "docker compose -f packages/ant-cli/src/periphery/integrations/vector-memory/docker-compose.yml down",
    "dev:mock": "ANT_LLM_MOCK=true pnpm --filter @ant/cli dev:server",
    "dev:mock:all": "concurrently -n cli,ui -c cyan,magenta \"pnpm dev:mock\" \"pnpm dev:ui\"",
    "test:cli": "pnpm --filter @ant/cli test",
    "test:e2e": "pnpm --filter @ant/cli exec vitest run tests/e2e-mock/",
    "test:e2e:real": "ANT_E2E_TIMEOUT=300000 pnpm --filter @ant/cli exec vitest run tests/e2e-mock/",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @ant/shared build",
    "build:cli": "pnpm --filter @ant/shared build && pnpm --filter @ant/cli build",
    "build:ui": "pnpm --filter @ant/ui build",
    "build:ui:local": "VITE_CLOUD_BACKEND_BASE= VITE_ANT_SITE_URL=/ VITE_PREVIEW_HOST=http://localhost:4102 pnpm --filter @ant/ui build",
    "build:site": "pnpm --filter @ant/site build",
    "build:site:local": "NEXT_PUBLIC_API_BASE= pnpm --filter @ant/site build",
    "start:ui": "pnpm --filter @ant/ui preview --port 4200",
    "start:site": "pnpm --filter @ant/site start",
    "start:server": "pnpm --filter @ant/cli start:server",
    "start:all": "concurrently -n cli,ui,site -c cyan,magenta,green \"pnpm start:server\" \"pnpm start:ui\" \"pnpm start:site\"",
    "start:mock": "ANT_LLM_MOCK=true pnpm --filter @ant/cli start:server",
    "start:mock:all": "concurrently -n cli,ui -c cyan,magenta \"pnpm start:mock\" \"pnpm start:ui\"",
    "start:api-server": "pnpm --filter @ant/cli start:api-server",
    "start:realtime-server": "pnpm --filter @ant/cli start:realtime-server",
    "start:job-worker": "pnpm --filter @ant/cli start:job-worker",
    "start:preview-server": "pnpm --filter @ant/cli start:preview-server",
    "init:workspace": "pnpm --filter @ant/cli init:workspace",
    "init:feature": "pnpm --filter @ant/cli init:feature",
    "git:sweep": "node scripts/git-sweep.mjs",
    "typecheck:cli": "pnpm --filter @ant/cli exec tsc --noEmit",
    "typecheck:ui": "pnpm --filter @ant/ui exec tsc --noEmit",
    "typecheck": "pnpm typecheck:cli && pnpm typecheck:ui",
    "test:git": "pnpm --filter @ant/ui test:git"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "spec-driven",
    "claude",
    "figma",
    "langgraph",
    "self-hosted",
    "design-to-code",
    "prd"
  ],
  "author": "The Ant Authors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.41",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/<org>/ant"
  },
  "homepage": "https://github.com/<org>/ant#readme",
  "bugs": {
    "url": "https://github.com/<org>/ant/issues"
  }
}
